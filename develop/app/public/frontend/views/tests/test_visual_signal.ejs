<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тест реакции</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: Montserrat;
            text-align: center;
            flex-direction: column;
            position: relative;
            background-color: black;
            color: white;
        }

        /* Новая секция для кнопок выбора длительности */
        #durationButtons {
            margin-bottom: 20px;
        }
        .durationBtn {
            padding: 10px 20px;
            margin: 5px;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background: #479C92; /* изначально подсвечена */
            color: white;
            transition: background-color 0.3s;
        }
        .durationBtn.selected {
            background: gray;
        }

        #signal {
            width: 100px;
            height: 100px;
            background-color: red;
            border-radius: 50%; /* Круглый сигнал */
            display: none;
            margin: 20px auto;
        }
        #reactionButton {
            display: none; /* Скрыто до начала теста */
            position: absolute;
            bottom: 20px; /* Фиксированное положение внизу */
            left: 50%;
            transform: translateX(-50%);
            padding: 10px 20px;
            font-size: 18px;
            cursor: pointer;
            font-family: Montserrat;
            background: #479C92;
            color: white;
            border-color: #479C92;
            border-radius: 10px;
        }
        #results {
            display: none;
            margin-top: 20px;
            font-family: Montserrat;
        }
        h1, p {
            margin: 10px 0;
            font-family: Montserrat;
        }
        #startButton {
            background: #479C92;
            color: white;
            font-family: Montserrat;
            border-color: #479C92;
            border-radius: 10px;
            font-size: 18px;
        }
        .disabled{
            opacity:0.5;
        }
    </style>
</head>
<body>
<h1>Тест на время реакции</h1>
<p id="textAboutTest">Нажмите кнопку "Старт", затем как можно быстрее нажмите кнопку при появлении красного круга.</p>

<!-- Новые кнопки выбора длительности -->
<div id="durationButtons">
    <button class="durationBtn" data-duration="30">30 с</button>
    <button class="durationBtn" data-duration="60">60 с</button>
    <button class="durationBtn" data-duration="120">120 с</button>
</div>

<button id="startButton">Старт</button>
<div id="signal"></div>
<button id="reactionButton">Нажмите как можно быстрее!</button>

<div id="results">
    <h2>Результаты теста</h2>
    <p>Среднее время реакции: <span id="averageTime"></span> мс</p>
    <p>Стандартное отклонение: <span id="stdDev"></span> мс</p>
    <p>Пропущено сигналов: <span id="missedSignals"></span></p>
</div>

<script>
    // Добавляем обработку выбора длительности теста
    // По умолчанию устанавливаем длительность 120 с (120*1000 мс)
    let testDuration = 120 * 1000;
    const durationButtons = document.querySelectorAll('.durationBtn');
    durationButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            durationButtons.forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            testDuration = parseInt(btn.dataset.duration) * 1000;
        });
    });

    let reactionTimes = [];
    let missedSignals = 0;
    let signalCount = 0;
    let totalTime = 0;
    let isTestRunning = false;
    let testStartTime;

    const signalElement = document.getElementById('signal');
    const startButton = document.getElementById('startButton');
    const reactionButton = document.getElementById('reactionButton');
    const averageTimeElement = document.getElementById('averageTime');
    const stdDevElement = document.getElementById('stdDev');
    const missedSignalsElement = document.getElementById('missedSignals');
    const resultsElement = document.getElementById('results');

    // Функция для старта теста
    function startTest() {
        const textAboutTest = document.getElementById('textAboutTest');
        const durationButtons = document.getElementById('durationButtons');
        durationButtons.style.display = 'none';
        textAboutTest.style.display = 'none';
        signalCount = 0;
        reactionTimes = [];
        missedSignals = 0;
        isTestRunning = true;
        testStartTime = Date.now(); // Запоминаем время старта теста
        startButton.disabled = true;
        startButton.textContent = "Тест в процессе...";
        reactionButton.style.display = 'block'; // Показываем кнопку
        signalElement.style.display = 'none'; // Прячем сигнал в начале
        resultsElement.style.display = 'none'; // Скрыть результаты перед новым тестом
        startTestCycle();

        // Закрываем тест по истечению выбранного времени
        setTimeout(endTest, testDuration);
    }

    // Функция для запуска сигнала
    function startTestCycle() {
        if (!isTestRunning || Date.now() - testStartTime >= testDuration) {
            endTest();
            return;
        }

        signalCount++;
        let randomDelay = Math.random() * 3000 + 1000;  // случайное время от 1 до 3 секунд

        setTimeout(() => {
            signalElement.style.display = 'block';
            const startTime = Date.now();

            reactionButton.onclick = function() {
                const reactionTime = Date.now() - startTime;
                reactionTimes.push(reactionTime);
                signalElement.style.display = 'none';

                // Подготовка к следующему сигналу
                setTimeout(startTestCycle, Math.random() * 3000 + 1000);
            };

            // Увеличение количества пропусков если сигнал не был замечен
            setTimeout(() => {
                if (signalElement.style.display === 'block') {
                    missedSignals++;
                    signalElement.style.display = 'none';
                    setTimeout(startTestCycle, Math.random() * 3000 + 1000); // Следующий сигнал
                }
            }, randomDelay);
        }, randomDelay);
    }

    // Функция для завершения теста
    function endTest() {
        isTestRunning = false;
        startButton.disabled = false;
        startButton.textContent = "Начать новый тест";
        reactionButton.style.display = 'none'; // Скрыть кнопку
        signalElement.style.display = 'none'; // Скрыть сигнал
        displayResults();
    }

    // Функция для отображения результатов
    function displayResults() {
        let averageReactionTime = 0;
        let standardDeviation = 0;

        if (reactionTimes.length === 0) {
            averageTimeElement.textContent = "0";
            stdDevElement.textContent = "0";
        } else {
            totalTime = reactionTimes.reduce((a, b) => a + b, 0);
            averageReactionTime = totalTime / reactionTimes.length;
            averageTimeElement.textContent = averageReactionTime.toFixed(2);

            const variance = reactionTimes.reduce((a, b) => a + Math.pow(b - averageReactionTime, 2), 0) / reactionTimes.length;
            standardDeviation = Math.sqrt(variance);
            stdDevElement.textContent = standardDeviation.toFixed(2);
        }

        missedSignalsElement.textContent = missedSignals;
        resultsElement.style.display = 'block';

        // Собираем данные для отправки
        const testResults = {
            averageTime: averageReactionTime,
            stdDev: standardDeviation,
            missedSignals: missedSignals,
            totalSignals: signalCount,
            reactionTimes: reactionTimes,
            testDuration: testDuration / 1000, // в секундах
        };

        // Отправляем результаты на сервер
        sendResultsToServer(testResults);
    }

    // Функция для отправки результатов на сервер
    function sendResultsToServer(results) {
        fetch('http://localhost:3000/api//test_visual_signal', {
            method: 'POST', // Используем POST для отправки результатов
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(results),
        })
            .then(response => response.json())
            .then(data => {
                if (data.message === 'Результаты сохранены') {
                    console.log('Результаты успешно отправлены на сервер');
                    // Можно добавить уведомление для пользователя
                } else {
                    console.error('Ошибка при сохранении результатов:', data.message);
                    alert('Ошибка при сохранении результатов.');
                }
            })
            .catch(error => {
                console.error('Ошибка:', error);
                alert('Произошла ошибка при отправке результатов.');
            });
    }

    // Начать тест по кнопке
    startButton.addEventListener('click', startTest);
</script>
</body>
</html>