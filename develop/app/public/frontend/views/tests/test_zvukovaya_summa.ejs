<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тест на чётность суммы</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');

        :root {
            --primary-color: #479C92;
            --primary-hover: #2d5e58;
            --accent-color: #FF6B6B;
            --background-color: #121212;
            --card-color: #1E1E1E;
            --text-color: #FFFFFF;
            --border-radius: 12px;
            --box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            --disabled-color: #666666;
            --pressed-color: #333333;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            position: relative;
        }

        .header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            margin-bottom: 30px;
        }

        .btn {
            padding: 12px 24px;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: var(--border-radius);
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: 'Montserrat', sans-serif;
            position: relative;
            overflow: hidden;
        }

        .btn-primary {
            background-color: var(--primary-color);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .btn-primary:disabled {
            background-color: var(--disabled-color);
            cursor: not-allowed;
        }

        .btn-accent {
            background-color: var(--accent-color);
            color: white;
        }

        .btn-accent:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        .btn-even {
            background-color: #4CAF50;
            color: white;
        }

        .btn-odd {
            background-color: #F44336;
            color: white;
        }

        .btn-pressed {
            transform: scale(0.98);
            box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.3);
        }

        .btn-disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
            box-shadow: none !important;
            background-color: var(--disabled-color) !important;
        }

        .btn-pressed-gray {
            background-color: var(--disabled-color) !important;
            transform: scale(0.98);
            transition: all 0.2s ease;
        }

        .test-container {
            background-color: var(--card-color);
            border-radius: var(--border-radius);
            padding: 30px;
            width: 100%;
            max-width: 600px;
            box-shadow: var(--box-shadow);
            text-align: center;
            margin-bottom: 30px;
            position: relative;
            overflow: hidden;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 20px;
            color: var(--primary-color);
        }

        p {
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .duration-selector {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 20px 0;
            flex-wrap: wrap;
        }

        .duration-btn {
            padding: 10px 20px;
            background-color: #333;
            color: white;
            border: none;
            border-radius: var(--border-radius);
            cursor: pointer;
            transition: all 0.3s;
            font-family: 'Montserrat', sans-serif;
        }

        .duration-btn.selected {
            background-color: var(--primary-color);
            transform: translateY(-2px);
        }

        .reaction-area {
            width: 200px;
            height: 200px;
            background-color: var(--card-color);
            border: 3px dashed #444;
            border-radius: 50%;
            margin: 30px auto;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            transition: all 0.3s;
        }

        .reaction-area.active {
            border-color: var(--accent-color);
            box-shadow: 0 0 30px rgba(255, 107, 107, 0.3);
        }

        .btn-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }

        .progress-container {
            width: 100%;
            height: 8px;
            background-color: #333;
            border-radius: 4px;
            margin: 20px 0;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background-color: var(--primary-color);
            width: 0%;
            transition: width 0.3s;
        }

        .results {
            background-color: var(--card-color);
            border-radius: var(--border-radius);
            padding: 25px;
            width: 100%;
            max-width: 600px;
            box-shadow: var(--box-shadow);
            display: none;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .stat-card {
            background-color: #2a2a2a;
            padding: 15px;
            border-radius: var(--border-radius);
            text-align: center;
        }

        .stat-card h3 {
            font-size: 14px;
            color: #aaa;
            margin-bottom: 5px;
        }

        .stat-card p {
            font-size: 24px;
            font-weight: 700;
            margin: 0;
        }

        #inviteWidget {
            margin: 40px auto;
            padding: 20px;
            max-width: 600px;
            background: #2c2c2c;
            border-radius: var(--border-radius);
            border: 1px solid var(--primary-color);
        }

        #inviteWidget h3 {
            margin-top: 0;
            color: var(--primary-color);
        }

        #inviteLink {
            padding: 12px;
            background: #232323;
            border: 1px solid var(--primary-color);
            border-radius: 4px;
            word-break: break-all;
            margin: 15px 0;
            color: white;
        }

        .share-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .share-button {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            transition: all 0.3s;
        }

        #copyButton {
            background: var(--primary-color);
            color: white;
        }

        #whatsappButton {
            background: #25D366;
            color: white;
        }

        #telegramButton {
            background: #0088cc;
            color: white;
        }

        .share-button:hover {
            opacity: 0.8;
            transform: translateY(-2px);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .fade-in {
            animation: fadeIn 0.5s ease-out;
        }

        @media (max-width: 600px) {
            .stats {
                grid-template-columns: 1fr;
            }
            
            .btn-container, .duration-selector {
                flex-direction: column;
            }
            
            .test-container, .results, #inviteWidget {
                padding: 20px;
            }
        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <div class="header">
        <button class="btn btn-primary" onclick="window.location.href='/main'">
            <i class="fas fa-home"></i> Главная страница
        </button>
    </div>

    <div class="test-container fade-in">
        <h1><i class="fas fa-calculator"></i> Тест на чётность суммы</h1>
        <p id="instructions">Нажмите кнопку "Начать тест", затем слушайте пару чисел и определяйте чётность суммы</p>
        
        <div class="duration-selector" id="durationButtons">
            <button class="duration-btn selected" data-duration="30">30 секунд</button>
            <button class="duration-btn" data-duration="60">1 минута</button>
            <button class="duration-btn" data-duration="120">2 минуты</button>
        </div>
        
        <div class="reaction-area" id="reactionArea">
            <i class="fas fa-headphones" style="font-size: 50px; color: #666;"></i>
        </div>
        
        <div class="btn-container">
            <button class="btn btn-even" id="evenButton" disabled>Чётная</button>
            <button class="btn btn-odd" id="oddButton" disabled>Нечётная</button>
        </div>
        
        <div class="progress-container">
            <div class="progress-bar" id="progressBar"></div>
        </div>
        
        <button class="btn btn-primary" id="startButton">Начать тест</button>
    </div>

    <div class="results" id="results">
        <h2><i class="fas fa-chart-bar"></i> Результаты теста</h2>
        
        <div class="stats">
            <div class="stat-card">
                <h3>Правильные ответы</h3>
                <p id="correctCount">0</p>
                <small>из <span id="totalCount">0</span></small>
            </div>
            <div class="stat-card">
                <h3>Среднее время</h3>
                <p id="averageTime">0</p>
                <small>миллисекунд</small>
            </div>
            <div class="stat-card">
                <h3>Лучший результат</h3>
                <p id="bestTime">0</p>
                <small>миллисекунд</small>
            </div>
            <div class="stat-card">
                <h3>Точность</h3>
                <p id="accuracy">0%</p>
            </div>
        </div>
        
        <button class="btn btn-accent" id="restartButton">Повторить тест</button>
    </div>

    <div id="inviteWidget" class="fade-in">
        <h3><i class="fas fa-share-alt"></i> Пригласите друзей</h3>
        <p>Ваша реферальная ссылка:</p>
        <div id="inviteLink"></div>
        <div class="share-buttons">
            <button id="copyButton" class="share-button">Копировать</button>
            <button id="whatsappButton" class="share-button">WhatsApp</button>
            <button id="telegramButton" class="share-button">Telegram</button>
        </div>
    </div>

    <script>
        const config = {
            delayAfterAnswer: 3000,
            numberRange: { min: 1, max: 9 },
            speechRate: 0.9
        };

        let state = {
            testDuration: 30000,
            isRunning: false,
            startTime: null,
            endTime: null,
            numbersSpokenTime: null,
            currentNumbers: [],
            correctAnswer: null,
            timeoutIds: [],
            progressInterval: null,
            synth: window.speechSynthesis,
            currentAttempt: {
                correct: 0,
                total: 0,
                times: [],
                bestTime: null
            },
            voiceReady: false,
            waitingForAnswer: false
        };

        const elements = {
            reactionArea: document.getElementById('reactionArea'),
            startButton: document.getElementById('startButton'),
            restartButton: document.getElementById('restartButton'),
            evenButton: document.getElementById('evenButton'),
            oddButton: document.getElementById('oddButton'),
            results: document.getElementById('results'),
            correctCount: document.getElementById('correctCount'),
            totalCount: document.getElementById('totalCount'),
            averageTime: document.getElementById('averageTime'),
            bestTime: document.getElementById('bestTime'),
            accuracy: document.getElementById('accuracy'),
            progressBar: document.getElementById('progressBar'),
            instructions: document.getElementById('instructions'),
            durationButtons: document.querySelectorAll('.duration-btn')
        };

        // Реферальные функции
        function generateReferralLink() {
            const testUrl = window.location.href.split('?')[0];
            let userId = 'guest';

            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('ref')) {
                userId = urlParams.get('ref');
            } else if (document.cookie.includes('user_id=')) {
                userId = document.cookie
                    .split('; ')
                    .find(row => row.startsWith('user_id='))
                    .split('=')[1];
            } else if (localStorage.getItem('user_id')) {
                userId = localStorage.getItem('user_id');
            }

            return `${testUrl}?ref=${encodeURIComponent(userId)}`;
        }

        function copyToClipboard() {
            const inviteLink = document.getElementById('inviteLink').textContent;
            navigator.clipboard.writeText(inviteLink)
                .then(() => {
                    const button = document.getElementById('copyButton');
                    const originalText = button.textContent;
                    button.textContent = 'Скопировано!';
                    setTimeout(() => button.textContent = originalText, 2000);
                })
                .catch(err => {
                    console.error('Ошибка копирования:', err);
                    const textarea = document.createElement('textarea');
                    textarea.value = inviteLink;
                    document.body.appendChild(textarea);
                    textarea.select();
                    try {
                        document.execCommand('copy');
                        const button = document.getElementById('copyButton');
                        button.textContent = 'Скопировано!';
                        setTimeout(() => button.textContent = 'Копировать', 2000);
                    } catch (err) {
                        alert('Не удалось скопировать ссылку. Скопируйте вручную.');
                    }
                    document.body.removeChild(textarea);
                });
        }

        function shareViaWhatsApp() {
            const inviteLink = document.getElementById('inviteLink').textContent;
            const text = `Попробуй этот тест: ${inviteLink}`;
            window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
        }

        function shareViaTelegram() {
            const inviteLink = document.getElementById('inviteLink').textContent;
            const text = `Попробуй этот тест: ${inviteLink}`;
            window.open(`https://t.me/share/url?url=${encodeURIComponent(inviteLink)}&text=${encodeURIComponent(text)}`, '_blank');
        }

        function initInviteWidget() {
            const inviteLink = generateReferralLink();
            document.getElementById('inviteLink').textContent = inviteLink;
            
            document.getElementById('copyButton').addEventListener('click', copyToClipboard);
            document.getElementById('whatsappButton').addEventListener('click', shareViaWhatsApp);
            document.getElementById('telegramButton').addEventListener('click', shareViaTelegram);
        }

        document.addEventListener('DOMContentLoaded', () => {
            initEventListeners();
            prepareVoice();
            initInviteWidget();
            
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('ref')) {
                const referrerId = urlParams.get('ref');
                console.log('Реферал от:', referrerId);
            }
        });

        function initEventListeners() {
            elements.startButton.addEventListener('click', startTest);
            elements.restartButton.addEventListener('click', resetTest);
            
            elements.evenButton.addEventListener('click', function() {
                if (state.waitingForAnswer && !this.disabled) {
                    handleAnswer('even');
                }
            });
            
            elements.oddButton.addEventListener('click', function() {
                if (state.waitingForAnswer && !this.disabled) {
                    handleAnswer('odd');
                }
            });
            
            elements.durationButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    elements.durationButtons.forEach(b => b.classList.remove('selected'));
                    this.classList.add('selected');
                    state.testDuration = parseInt(this.dataset.duration) * 1000;
                });
            });
        }

        function prepareVoice() {
            if (!state.synth) return;
            
            const voicesReady = setInterval(() => {
                const voices = state.synth.getVoices();
                if (voices.length > 0) {
                    clearInterval(voicesReady);
                    state.voiceReady = true;
                    
                    const utterance = new SpeechSynthesisUtterance('');
                    utterance.rate = config.speechRate;
                    utterance.lang = 'ru-RU';
                    state.synth.speak(utterance);
                }
            }, 100);
        }

        function speakNumbersPair(numbers) {
            return new Promise((resolve) => {
                if (!state.synth || !state.voiceReady) {
                    resolve();
                    return;
                }

                state.synth.cancel();
                
                setTimeout(() => {
                    const utterance = new SpeechSynthesisUtterance(numbers.join(' '));
                    utterance.lang = 'ru-RU';
                    utterance.rate = config.speechRate;
                    
                    utterance.onend = function() {
                        resolve();
                    };
                    
                    utterance.onerror = function() {
                        resolve();
                    };
                    
                    state.synth.speak(utterance);
                }, 50);
            });
        }

        function generateRandomNumbers() {
            const num1 = Math.floor(Math.random() * (config.numberRange.max - config.numberRange.min + 1)) + config.numberRange.min;
            const num2 = Math.floor(Math.random() * (config.numberRange.max - config.numberRange.min + 1)) + config.numberRange.min;
            const sum = num1 + num2;
            
            return {
                numbers: [num1, num2],
                sum: sum,
                isEven: sum % 2 === 0
            };
        }

        async function startTest() {
            if (state.isRunning) return;
            
            resetTestState();
            
            elements.startButton.disabled = true;
            elements.startButton.textContent = "Тест выполняется...";
            elements.instructions.textContent = "Слушайте пару чисел и определяйте чётность суммы";
            elements.results.style.display = "none";
            
            state.isRunning = true;
            state.startTime = Date.now();
            state.endTime = state.startTime + state.testDuration;
            
            updateProgressBar();
            state.progressInterval = setInterval(updateProgressBar, 100);
            
            state.timeoutIds.push(setTimeout(() => {
                endTest();
            }, state.testDuration));
            
            await askQuestion();
        }

        async function askQuestion() {
            if (!state.isRunning || Date.now() >= state.endTime) {
                endTest();
                return;
            }

            const { numbers, isEven } = generateRandomNumbers();
            state.currentNumbers = numbers;
            state.correctAnswer = isEven ? 'even' : 'odd';
            
            elements.reactionArea.classList.add("active");
            
            await speakNumbersPair(numbers);
            
            if (!state.isRunning || Date.now() >= state.endTime) {
                endTest();
                return;
            }
            
            state.numbersSpokenTime = Date.now();
            state.waitingForAnswer = true;
            
            enableAnswerButtons();
        }

        function handleAnswer(answer) {
            if (!state.isRunning || Date.now() >= state.endTime) {
                endTest();
                return;
            }

            const button = answer === 'even' ? elements.evenButton : elements.oddButton;
            button.classList.add('btn-pressed-gray');
            setTimeout(() => button.classList.remove('btn-pressed-gray'), 500);

            const reactionTime = Date.now() - state.numbersSpokenTime;
            state.currentAttempt.times.push(reactionTime);
            state.currentAttempt.total++;
            
            if (answer === state.correctAnswer) {
                state.currentAttempt.correct++;
                if (state.currentAttempt.bestTime === null || reactionTime < state.currentAttempt.bestTime) {
                    state.currentAttempt.bestTime = reactionTime;
                }
            }
            
            state.waitingForAnswer = false;
            disableAnswerButtons();
            elements.reactionArea.classList.remove("active");
            
            state.timeoutIds.forEach(id => clearTimeout(id));
            state.timeoutIds = [];
            
            const timeLeft = state.endTime - Date.now();
            if (timeLeft <= config.delayAfterAnswer) {
                endTest();
                return;
            }
            
            state.timeoutIds.push(setTimeout(() => {
                if (state.isRunning && Date.now() < state.endTime) {
                    askQuestion();
                } else {
                    endTest();
                }
            }, config.delayAfterAnswer));
        }

        function enableAnswerButtons() {
            elements.evenButton.disabled = false;
            elements.oddButton.disabled = false;
        }

        function disableAnswerButtons() {
            elements.evenButton.disabled = true;
            elements.oddButton.disabled = true;
        }

        function endTest() {
            if (!state.isRunning) return;
            
            state.isRunning = false;
            clearInterval(state.progressInterval);
            
            if (state.synth) {
                state.synth.cancel();
            }
            
            state.timeoutIds.forEach(id => clearTimeout(id));
            state.timeoutIds = [];
            
            elements.startButton.disabled = false;
            elements.startButton.textContent = "Начать тест";
            elements.instructions.textContent = "Нажмите кнопку \"Начать тест\", затем слушайте пару чисел и определяйте чётность суммы";
            elements.reactionArea.classList.remove("active");
            disableAnswerButtons();
            
            showResults();
        }

        function showResults() {
            const accuracy = state.currentAttempt.total > 0 
                ? Math.round((state.currentAttempt.correct / state.currentAttempt.total) * 100) 
                : 0;
                
            const averageTime = state.currentAttempt.times.length > 0 
                ? Math.round(state.currentAttempt.times.reduce((a, b) => a + b, 0) / state.currentAttempt.times.length) 
                : 0;
                
            const bestTime = state.currentAttempt.bestTime || 0;

            elements.correctCount.textContent = state.currentAttempt.correct;
            elements.totalCount.textContent = state.currentAttempt.total;
            elements.averageTime.textContent = averageTime;
            elements.bestTime.textContent = bestTime;
            elements.accuracy.textContent = accuracy + "%";
            
            elements.results.style.display = "block";
            elements.results.classList.add("fade-in");
            sendResultsToServer();

        }

        function resetTestState() {
            state.timeoutIds.forEach(id => clearTimeout(id));
            if (state.progressInterval) clearInterval(state.progressInterval);
            
            if (state.synth) {
                state.synth.cancel();
            }
            
            state = {
                ...state,
                isRunning: false,
                startTime: null,
                endTime: null,
                numbersSpokenTime: null,
                currentNumbers: [],
                correctAnswer: null,
                timeoutIds: [],
                progressInterval: null,
                currentAttempt: {
                    correct: 0,
                    total: 0,
                    times: [],
                    bestTime: null
                },
                waitingForAnswer: false
            };
            
            elements.progressBar.style.width = "0%";
            disableAnswerButtons();
        }

        function resetTest() {
            resetTestState();
            elements.results.style.display = "none";
        }

        function updateProgressBar() {
            if (!state.startTime || !state.isRunning) return;
            
            const now = Date.now();
            if (now >= state.endTime) {
                endTest();
                return;
            }
            
            const elapsed = now - state.startTime;
            const progress = Math.min((elapsed / state.testDuration) * 100, 100);
            elements.progressBar.style.width = `${progress}%`;
            
            if (progress > 80) {
                elements.progressBar.style.backgroundColor = "#ff6b6b";
            } else if (progress > 50) {
                elements.progressBar.style.backgroundColor = "#feca57";
            } else {
                elements.progressBar.style.backgroundColor = "#479C92";
            }
        }

        

        function sendResultsToServer() {
            const results = {
        login: "<%= login %>",
        reactionTimes: state.currentAttempt.times,
        correctAnswers: state.currentAttempt.correct,
        wrongAnswers: state.currentAttempt.total - state.currentAttempt.correct,
        testDuration: state.testDuration / 1000,
        bestTime: state.currentAttempt.bestTime || 0,
        accuracy: Math.round((state.currentAttempt.correct / state.currentAttempt.total) * 100) || 0
    };
            
            fetch('http://localhost:3000/api/test_reaction', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(results),
            })
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    console.error('Ошибка при сохранении результатов:', data.message);
                }
            })
            .catch(error => {
                console.error('Ошибка при отправке результатов:', error);
            });
        }

          // Инициализация при загрузке страницы
    document.addEventListener('DOMContentLoaded', function() {
        startBtn.addEventListener('click', startTest);
        evenBtn.addEventListener('click', () => handleAnswer(true));
        oddBtn.addEventListener('click', () => handleAnswer(false));

        initInviteWidget();
        
        // Проверяем, пришел ли пользователь по реферальной ссылке
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('ref')) {
            const referrerId = urlParams.get('ref');
