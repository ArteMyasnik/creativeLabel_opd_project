<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тест реакции</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');

        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: black;
            color: white;
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 20px;
            position: relative;
            overflow-y: auto;
        }

        body::before {
            content: "";
            background-image: url("../../Images/фон.jpg");
            background-size: cover;
            background-position: center;
            opacity: 0.2;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: -1;
            pointer-events: none;
        }

        /* Стили для кнопки "Главная страница" */
        .top-button-container {
            position: absolute;
            top: 10px;
            left: 10px;
            width: 100%;
            display: flex;
            justify-content: flex-start;
        }

        .main-page-btn {
            padding: 0.7rem 2rem;
            font-size: 17px;
            font-family: 'Montserrat', sans-serif;
            cursor: pointer;
            border: none;
            border-radius: 20px;
            background-color: #479C92;
            color: white;
            transition: background-color 0.3s ease;
            margin: 0.5rem;
        }

        .main-page-btn:hover {
            background-color: #2d5e58;
        }

        /* Новая секция для кнопок выбора длительности */
        #durationButtons {
            margin-bottom: 20px;
        }
        .durationBtn {
            padding: 10px 20px;
            margin: 5px;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background: #479C92; /* изначально подсвечена */
            color: white;
            transition: background-color 0.3s;
        }
        .durationBtn.selected {
            background: gray;
        }

        #test-container {
            position: relative;
            width: 300px;
            height: 300px;
            background: brown;
            border-radius: 50%;
            border: 3px solid black;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
        }

        #divider {
            position: absolute;
            width: 3px;
            height: 100%;
            background: black;
        }

        .side {
            position: absolute;
            width: 50%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            color: white;
        }

        #left-side {
            left: 0;
        }

        #right-side {
            right: 0;
        }

        #ball {
            position: absolute;
            width: 20px;
            height: 20px;
            background: red;
            border-radius: 50%;
            top: 10px;
        }

        #star {
            position: absolute;
            top: 5%;
            left: 50%;
            transform: translateX(-50%);
            font-size: 30px;
            color: gold;
        }

        .button-container {
            padding-top: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 5px;
            background-repeat: no-repeat;
            font-size: 0;
        }

        .button-container button {
            margin: 0.5rem 0.5rem;
            padding: 0.7rem 2rem;
            font-size: 17px;
            font-family: 'Montserrat', sans-serif;
            cursor: pointer;
            border: none;
            border-radius: 20px;
            background-color: #479C92;
            color: white;
        }

        .button-container button:hover {
            background-color: #2d5e58;
            transition: all 0.3s ease;
        }

        #results {
            width: 90%;
            max-width: 600px;
            margin-top: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        table, th, td {
            border: 1px solid #000;
        }

        th, td {
            padding: 8px;
            text-align: center;
        }

        th {
            background-color: #f2f2f2;
            color: black;
        }

        .result-block {
            margin-top: 20px;
            text-align: left;
            width: 100%;
            max-width: 600px;
        }
    </style>
</head>
<body>
<!-- Кнопка "Главная страница" в левом верхнем углу -->
<div class="top-button-container">
    <button class="main-page-btn" onclick="window.location.href='/main'">Главная страница</button>
</div>

<!-- Новая секция для кнопок выбора длительности -->
<div id="durationButtons">
    <button class="durationBtn" data-duration="30">30 с</button>
    <button class="durationBtn" data-duration="60">60 с</button>
    <button class="durationBtn" data-duration="120">120 с</button>
</div>

<div id="test-container">
    <div id="divider"></div>
    <div id="left-side" class="side">+</div>
    <div id="right-side" class="side">-</div>
    <div id="ball"></div>
    <div id="star">★</div>
</div>
<div class="button-container">
    <button onclick="startTest()">Начать тест</button>
    <button onclick="stopTest()">Нажмите на кнопку</button>
</div>
<div id="results"></div>

<script>
    // Обработка выбора длительности теста:
    // По умолчанию длительность теста 120 с (120000 мс)
    let testDuration = 120000;
    const durationButtons = document.querySelectorAll('.durationBtn');
    durationButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            durationButtons.forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            testDuration = parseInt(btn.dataset.duration) * 1000;
        });
    });

    // Массив для хранения результатов каждой попытки:
    // Каждый элемент: { attempt, signedError, absoluteError }
    let results = [];
    let testRunning = false;
    let angle = 180;
    let interval;
    const radius = 130;
    const centerX = 150, centerY = 150;
    let stoppedAngle = null;
    let startTime;
    let bestResult = null;
    let testTimeout;
    const starAngle = 90; // Целевой угол

    function startTest() {
        if (testRunning) return;
        testRunning = true;
        angle = 180;
        stoppedAngle = null;
        startTime = Date.now();
        bestResult = null;
        results = [];
        document.getElementById("results").innerHTML = "";
        clearInterval(interval);
        clearTimeout(testTimeout);
        interval = setInterval(moveBall, 20);

        // Используем выбранную длительность теста
        testTimeout = setTimeout(() => {
            clearInterval(interval);
            testRunning = false;
            showFinalResults();
        }, testDuration);
    }

    function moveBall() {
        if (stoppedAngle !== null) return;
        let ball = document.getElementById("ball");
        let radian = angle * (Math.PI / 180);
        let x = centerX + radius * Math.cos(radian);
        let y = centerY - radius * Math.sin(radian);
        ball.style.left = x + "px";
        ball.style.top = y + "px";
        angle -= 2;
        if (angle < 0) {
            angle = 360;
        }
    }

    function stopTest() {
        if (!testRunning || stoppedAngle !== null) return;
        stoppedAngle = angle;
        clearInterval(interval);
        let signedError = stoppedAngle - starAngle;
        let absoluteError = Math.abs(signedError);
        results.push({
            attempt: results.length + 1,
            signedError: signedError,
            absoluteError: absoluteError
        });
        if (bestResult === null || absoluteError < bestResult) {
            bestResult = absoluteError;
        }
        if (Date.now() - startTime < testDuration) {
            setTimeout(() => {
                stoppedAngle = null;
                interval = setInterval(moveBall, 20);
            }, 1000);
        } else {
            testRunning = false;
            showFinalResults();
        }
    }

    function average(arr) {
        if (arr.length === 0) return 0;
        return arr.reduce((sum, val) => sum + val, 0) / arr.length;
    }

    function stdDeviation(arr) {
        if (arr.length === 0) return 0;
        let avg = average(arr);
        let squareDiffs = arr.map(val => Math.pow(val - avg, 2));
        let avgSquareDiff = average(squareDiffs);
        return Math.sqrt(avgSquareDiff);
    }

    function showFinalResults() {
        let resultDiv = document.getElementById("results");
        let html = "<h2>Результаты теста</h2>";

        if (results.length === 0) {
            html += "<p>Нет результатов.</p>";
            resultDiv.innerHTML = html;
            return;
        }

        // Вычисляем все показатели
        let premature = results.filter(r => r.signedError > 0).map(r => r.signedError);
        let delayed = results.filter(r => r.signedError < 0).map(r => r.signedError);
        let absErrors = results.map(r => r.absoluteError);

        let avgPremature = premature.length ? average(premature).toFixed(2) : "N/A";
        let avgDelayed = delayed.length ? average(delayed).toFixed(2) : "N/A";
        let avgAbsolute = average(absErrors).toFixed(2);
        let stdAbs = stdDeviation(absErrors).toFixed(2);
        let stdSigned = stdDeviation(results.map(r => r.signedError)).toFixed(2);
        let avgSigned = average(results.map(r => r.signedError));
        let signResponse = avgSigned > 0 ? "+" : (avgSigned < 0 ? "–" : "0");

        // Отображаем результаты
        html += `<table>
                <tr>
                  <th>Попытка</th>
                  <th>Подписанная ошибка (°)</th>
                  <th>Абсолютная ошибка (°)</th>
                </tr>`;

        results.forEach(r => {
            let sign = r.signedError > 0 ? "+" : (r.signedError < 0 ? "–" : "0");
            html += `<tr>
                  <td>${r.attempt}</td>
                  <td>${sign} ${Math.abs(r.signedError).toFixed(2)}</td>
                  <td>${r.absoluteError.toFixed(2)}</td>
                </tr>`;
        });

        html += `</table>
            <div class="result-block">
                <h3>Оценка:</h3>
                <p><strong>1. Точность ответов:</strong></p>
                <ul>
                  <li>Время преждевременного ответа (знак "+"): ${avgPremature}</li>
                  <li>Время запаздывания ответа (знак "–"): ${avgDelayed}</li>
                </ul>
                <p><strong>2. Значение по модулю:</strong> ${avgAbsolute}°</p>
                <p><strong>3. Знак ответа:</strong> ${signResponse}</p>
                <p><strong>4. Стандартное отклонение (абсолютное):</strong> ${stdAbs}</p>
                <p><strong>5. Стандартное отклонение (с учётом знака):</strong> ${stdSigned}</p>
            </div>`;

        resultDiv.innerHTML = html;

        // Подготовка данных для отправки
        const testData = {
            login: "<%= login %>",  // Замените на реальный способ получения логина
            attempts: results.map(r => ({
                signedError: r.signedError,
                absoluteError: r.absoluteError
            })),
            testDuration: testDuration / 1000
        };

        // Отправка данных на сервер
        sendResultsToServer(testData);
    }

    // Функция для отправки результатов на сервер
    function sendResultsToServer(results) {
        // Замените URL на ваш реальный эндпоинт сервера
        fetch('http://localhost:3000/api/test_simple_rdo', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(results),
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('Результаты успешно сохранены:', data.message);
                } else {
                    console.error('Ошибка при сохранении результатов:', data.message);
                }
            })
            .catch(error => {
                console.error('Ошибка при отправке результатов:', error);
            });
    }
</script>
</body>
</html>