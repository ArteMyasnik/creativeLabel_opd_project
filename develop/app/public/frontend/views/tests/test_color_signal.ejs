<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тест на сенсомоторную реакцию</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');

        /* Стили для кнопки "Главная страница" */
        .button-container {
            padding-top: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 5px;
            background-repeat: no-repeat;
            font-size: 0;
            width: 100%;
            position: absolute;
            top: 0;
            left: 0;
        }
        .button-container button {
            margin: 0.5rem 0.5rem;
            padding: 0.7rem 2rem;
            font-size: 17px;
            font-family: Montserrat;
            cursor: pointer;
            border: none;
            border-radius: 20px;
            background-color: #479C92;
            color: white;
        }
        .button-container button:hover {
            background-color: #2d5e58;
            transition: all 0.3s ease;
        }
        .left-button {
            margin-right: auto;
        }

        body {
            font-family: Montserrat;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            background-color: black;
            color: white;
            position: relative;
            padding-top: 60px; /* Добавляем отступ сверху для кнопки */
        }

        .signal {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            margin-bottom: 20px;
        }

        .buttons {
            display: none; /* Скрываем кнопки цветов по умолчанию */
            gap: 20px;
            margin-bottom: 20px;
        }

        .button {
            width: 100px;
            height: 50px;
            background-color: #479C92;
            color: white;
            border: none;
            border-radius: 10px;
            font-family: Montserrat;
            opacity: 0.96;
            cursor: pointer;
        }

        .button.disabled {
            opacity: 0.5;
            pointer-events: none;
        }

        /* Блок с результатами — изначально скрыт и без белого фона */
        #results {
            margin-top: 20px;
            display: none;
            padding: 20px;
            border-radius: 10px;
            width: 300px;
            text-align: center;
            background-color: black;
            color: white;
        }

        h1 {
            color: white;
            font-family: 'Montserrat', Arial, sans-serif;
            margin-top: 20px;
        }

        #startButton {
            margin-top: 20px;
            background-color: #479C92;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        #startButton.hidden {
            display: none; /* Класс для скрытия кнопки "Начать тест" */
        }

        /* Кнопки выбора времени */
        .time-buttons {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .time-button {
            width: 80px;
            height: 40px;
            background-color: #479C92;
            color: white;
            border: none;
            border-radius: 10px;
            font-family: Montserrat;
            cursor: pointer;
        }

        .time-button.disabled {
            opacity: 0.5;
            pointer-events: none;
        }

        /* Стили для виджета приглашения */
        #inviteWidget {
            margin: 40px auto;
            padding: 20px;
            max-width: 600px;
            background: #2c2c2c;
            border-radius: 8px;
            border: 1px solid #479C92;
        }
        #inviteWidget h3 {
            margin-top: 0;
            color: #479C92;
        }
        #inviteLink {
            padding: 12px;
            background: #232323;
            border: 1px solid #479C92;
            border-radius: 4px;
            word-break: break-all;
            margin: 15px 0;
            color: white;
        }
        .share-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .share-button {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-family: Montserrat;
            transition: all 0.3s;
        }
        #copyButton {
            background: #479C92;
            color: white;
        }
        #whatsappButton {
            background: #25D366;
            color: white;
        }
        #telegramButton {
            background: #0088cc;
            color: white;
        }
        .share-button:hover {
            opacity: 0.8;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
<div class="button-container">
    <div class="left-button">
        <button onclick="window.location.href='/main'">Главная страница</button>
    </div>
</div>

<h1>Тест на сенсомоторную реакцию</h1>
<div class="signal" id="signal"></div>

<!-- Кнопки выбора времени теста -->
<div class="time-buttons">
    <button class="time-button" onclick="setTestDuration(30, this)">30 сек</button>
    <button class="time-button" onclick="setTestDuration(60, this)">1 мин</button>
    <button class="time-button" onclick="setTestDuration(120, this)">2 мин</button>
</div>

<!-- Кнопки для выбора цвета (изначально скрыты) -->
<div class="buttons" id="colorButtons">
    <button class="button red">Красный</button>
    <button class="button blue">Синий</button>
    <button class="button green">Зеленый</button>
</div>

<!-- Кнопка старта -->
<button id="startButton" onclick="startTest()">Начать тест</button>

<!-- Блок результатов (скрыт до конца теста) -->
<div id="results"></div>

<!-- Виджет для приглашения друзей -->
<div id="inviteWidget">
    <h3>Пригласите друзей на этот тест</h3>
    <p>Ваша персональная ссылка:</p>
    <div id="inviteLink"></div>
    <div class="share-buttons">
        <button id="copyButton" class="share-button">Копировать</button>
        <button id="whatsappButton" class="share-button">WhatsApp</button>
        <button id="telegramButton" class="share-button">Telegram</button>
    </div>
</div>

<script>
    const colors = ['red', 'blue', 'green'];
    let currentColor = '';
    let startTime = 0;
    let reactionTimes = [];
    let correctAnswers = 0;
    let missedClicks = 0;
    let wrongClicks = 0;
    let testTimeout, signalTimeout;
    let testDuration = 30; // По умолчанию 30 секунд

    // Функция для генерации реферальной ссылки
    function generateReferralLink() {
        const testUrl = window.location.href.split('?')[0];
        let userId = 'guest';

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('ref')) {
            userId = urlParams.get('ref');
        }
        else if (document.cookie.includes('user_id=')) {
            userId = document.cookie
                .split('; ')
                .find(row => row.startsWith('user_id='))
                .split('=')[1];
        }
        else if (localStorage.getItem('user_id')) {
            userId = localStorage.getItem('user_id');
        }
        else if (sessionStorage.getItem('user_id')) {
            userId = sessionStorage.getItem('user_id');
        }

        return `${testUrl}?ref=${encodeURIComponent(userId)}&utm_source=referral&utm_medium=social&utm_campaign=motor_test`;
    }

    // Функции для работы с реферальными ссылками
    function copyToClipboard() {
        const inviteLink = document.getElementById('inviteLink').textContent;
        navigator.clipboard.writeText(inviteLink)
            .then(() => {
                const button = document.getElementById('copyButton');
                const originalText = button.textContent;
                button.textContent = 'Скопировано!';
                setTimeout(() => {
                    button.textContent = originalText;
                }, 2000);
            })
            .catch(err => {
                console.error('Ошибка копирования:', err);
                const textarea = document.createElement('textarea');
                textarea.value = inviteLink;
                document.body.appendChild(textarea);
                textarea.select();
                try {
                    document.execCommand('copy');
                    const button = document.getElementById('copyButton');
                    const originalText = button.textContent;
                    button.textContent = 'Скопировано!';
                    setTimeout(() => {
                        button.textContent = originalText;
                    }, 2000);
                } catch (err) {
                    alert('Не удалось скопировать ссылку. Пожалуйста, скопируйте вручную.');
                }
                document.body.removeChild(textarea);
            });
    }

    function shareViaWhatsApp() {
        const inviteLink = document.getElementById('inviteLink').textContent;
        const text = `Привет! Попробуй этот тест на сенсомоторную реакцию: ${inviteLink}`;
        window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
    }

    function shareViaTelegram() {
        const inviteLink = document.getElementById('inviteLink').textContent;
        const text = `Привет! Попробуй этот тест на сенсомоторную реакцию: ${inviteLink}`;
        window.open(`https://t.me/share/url?url=${encodeURIComponent(inviteLink)}&text=${encodeURIComponent(text)}`, '_blank');
    }

    // Инициализация виджета приглашения
    function initInviteWidget() {
        const inviteLink = generateReferralLink();
        document.getElementById('inviteLink').textContent = inviteLink;

        document.getElementById('copyButton').addEventListener('click', copyToClipboard);
        document.getElementById('whatsappButton').addEventListener('click', shareViaWhatsApp);
        document.getElementById('telegramButton').addEventListener('click', shareViaTelegram);
    }

    function setTestDuration(seconds, button) {
        testDuration = seconds;
        const timeButtons = document.querySelectorAll('.time-button');
        timeButtons.forEach(btn => btn.classList.remove('disabled'));
        button.classList.add('disabled');
    }

    function startSignal() {
        const signalElement = document.getElementById('signal');
        currentColor = colors[Math.floor(Math.random() * colors.length)];
        signalElement.style.backgroundColor = currentColor;
        startTime = Date.now();

        signalTimeout = setTimeout(() => {
            missedClicks++;
            signalElement.style.backgroundColor = 'transparent';
            startSignal();
        }, 5000);
    }

    function checkAnswer(answer) {
        clearTimeout(signalTimeout);
        const reactionTime = Date.now() - startTime;

        if (answer === currentColor) {
            correctAnswers++;
            reactionTimes.push(reactionTime);
        } else {
            wrongClicks++;
        }
        document.getElementById('signal').style.backgroundColor = 'transparent';
        startSignal();
    }

    function showResults() {
        let averageReactionTime = 0, standardDeviation = 0;
        if (reactionTimes.length > 0) {
            averageReactionTime = reactionTimes.reduce((a, b) => a + b, 0) / reactionTimes.length;
            const variance = reactionTimes
                .map(x => Math.pow(x - averageReactionTime, 2))
                .reduce((a, b) => a + b, 0) / reactionTimes.length;
            standardDeviation = Math.sqrt(variance);
        }

        const resultsDiv = document.getElementById('results');
        resultsDiv.innerHTML = `
        <p>Среднее время реакции: ${averageReactionTime.toFixed(2)} мс</p>
        <p>Стандартное отклонение: ${standardDeviation.toFixed(2)} мс</p>
        <p>Точность ответов: ${correctAnswers}</p>
        <p>Количество пропусков: ${missedClicks}</p>
        <p>Количество ошибок: ${wrongClicks}</p>
      `;
        resultsDiv.style.display = 'block';

        const testResults = {
            login: "<%= login %>",
            reactionTimes: reactionTimes,
            correctAnswers: correctAnswers,
            missedClicks: missedClicks,
            wrongClicks: wrongClicks,
            testDuration: testDuration
        };

        sendResultsToServer(testResults);
    }

    function sendResultsToServer(results) {
        fetch('http://localhost:3000/api/test_color_signal', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(results),
        })
            .then(response => response.json())
            .then(data => {
                if (data.success === true) {
                    console.log(data.message);
                } else {
                    console.error('Ошибка при сохранении результатов:', data.message);
                }
            })
            .catch(error => {
                console.error('Ошибка:', error);
                alert('Произошла ошибка при отправке результатов.');
            });
    }

    function finishTest() {
        clearTimeout(testTimeout);
        clearTimeout(signalTimeout);
        showResults();
        resetTest();
    }

    function resetTest() {
        // Показываем кнопку "Начать тест" снова
        document.getElementById('startButton').classList.remove('hidden');
        // Скрываем кнопки цветов
        document.getElementById('colorButtons').style.display = 'none';

        reactionTimes = [];
        correctAnswers = 0;
        missedClicks = 0;
        wrongClicks = 0;
        document.getElementById('signal').style.backgroundColor = 'transparent';
    }

    function startTest() {
        // Скрываем кнопку "Начать тест"
        document.getElementById('startButton').classList.add('hidden');
        // Показываем кнопки цветов
        document.getElementById('colorButtons').style.display = 'flex';

        // Сбрасываем предыдущие результаты
        reactionTimes = [];
        correctAnswers = 0;
        missedClicks = 0;
        wrongClicks = 0;
        document.getElementById('signal').style.backgroundColor = 'transparent';
        document.getElementById('results').style.display = 'none';

        // Назначаем обработчики для кнопок цветов
        const colorButtons = document.querySelectorAll('.button');
        colorButtons.forEach(button => {
            button.onclick = function () {
                const btnClasses = this.className.split(' ');
                checkAnswer(btnClasses[1]);
            }
        });

        startSignal();
        testTimeout = setTimeout(finishTest, testDuration * 1000);
    }

    // Инициализация при загрузке страницы
    document.addEventListener('DOMContentLoaded', function() {
        initInviteWidget();

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('ref')) {
            const referrerId = urlParams.get('ref');
            console.log('Пользователь пришел по реферальной ссылке от:', referrerId);
        }
    });
</script>
</body>
</html>