<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тест на сенсомоторную реакцию</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');

        body {
            font-family: Montserrat;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            background-color: black;
            color: white;
        }
        .signal {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            margin-bottom: 20px;
        }
        .buttons {
            display: flex;
            gap: 20px;
        }
        .button {
            width: 100px;
            height: 50px;
            background-color: #479C92;
            color: white;
            border-color: #479C92;
            border-radius: 10px;
            font-family: Montserrat;
            opacity: 0.96;
        }
        .button.disabled {
            opacity: 0.5;
            pointer-events: none;
        }
        #results {
            margin-top: 20px;
            display: none;
            padding: 20px;
            border: 1px solid #ccc;
            background-color: #f9f9f9;
            border-radius: 10px;
            width: 300px;
            text-align: center;
        }
        h1 {
            color: white;
            font-family: 'Montserrat', Arial, sans-serif;
        }
        #startButton {
            margin-top: 20px;
            background-color: #479C92;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            font-family: 'Montserrat', Arial, sans-serif;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        #startButton.disabled {
            opacity: 0.5;
            pointer-events: none;
        }
        #userDataModal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.7);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        #userDataForm {
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            color: black;
            width: 300px;
        }
        #userDataForm label {
            display: block;
            margin-bottom: 10px;
        }
        #userDataForm input, #userDataForm select {
            width: 100%;
            padding: 8px;
            margin-bottom: 15px;
            box-sizing: border-box;
        }
        #userDataForm button {
            background-color: #479C92;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>
<h1>Тест на сенсомоторную реакцию</h1>
<div class="signal" id="signal"></div>
<div class="buttons">
    <button class="button red disabled">Красный</button>
    <button class="button blue disabled">Синий</button>
    <button class="button green disabled">Зеленый</button>
</div>
<button id="startButton" onclick="startTest()">Начать тест</button>
<div id="results"></div>

<!-- Модальное окно для ввода данных пользователя -->
<div id="userDataModal">
    <div id="userDataForm">
        <h2>Пожалуйста, укажите ваши данные</h2>
        <label for="age">Возраст:</label>
        <input type="number" id="age" min="1" max="120" required>

        <label for="sex">Пол:</label>
        <select id="sex" required>
            <option value="">Выберите пол</option>
            <option value="male">Мужской</option>
            <option value="female">Женский</option>
            <option value="other">Другой</option>
        </select>

        <button onclick="saveUserData()">Сохранить</button>
    </div>
</div>

<script>
    const colors = ['red', 'blue', 'green'];
    let currentColor = '';
    let startTime = 0;
    let reactionTimes = [];
    let correctAnswers = 0;
    let missedClicks = 0;
    let wrongClicks = 0;
    let testTimeout;
    let signalTimeout;
    let userAge = null;
    let userSex = null;

    function startSignal() {
        const signalElement = document.getElementById('signal');
        currentColor = colors[Math.floor(Math.random() * colors.length)];
        signalElement.style.backgroundColor = currentColor;
        startTime = Date.now();
        signalTimeout = setTimeout(() => {
            if (!reactionTimes.includes(Date.now() - startTime)) {
                missedClicks++;
            }
            signalElement.style.backgroundColor = 'transparent';
            startSignal();
        }, 5000);
    }

    function checkAnswer(answer) {
        clearTimeout(signalTimeout);

        const endTime = Date.now();
        const reactionTime = endTime - startTime;

        if (answer === currentColor) {
            correctAnswers++;
            reactionTimes.push(reactionTime);
        } else {
            wrongClicks++;
        }

        startSignal();
    }

    function showResults() {
        let averageReactionTime = 0;
        let standardDeviation = 0;

        if (reactionTimes.length > 0) {
            averageReactionTime = reactionTimes.reduce((a, b) => a + b, 0) / reactionTimes.length;
            const variance = reactionTimes.map(x => Math.pow(x - averageReactionTime, 2)).reduce((a, b) => a + b, 0) / reactionTimes.length;
            standardDeviation = Math.sqrt(variance);
        }

        const resultsDiv = document.getElementById('results');
        resultsDiv.innerHTML = `
                <p>Среднее время реакции: ${averageReactionTime.toFixed(2)} мс</p>
                <p>Стандартное отклонение: ${standardDeviation.toFixed(2)} мс</p>
                <p>Точность ответов: ${correctAnswers}</p>
                <p>Количество пропусков: ${missedClicks}</p>
                <p>Количество ошибок - неправильное нажатие: ${wrongClicks}</p>
            `;
        resultsDiv.style.display = 'block';
    }

    function saveTestResults(averageReactionTime, standardDeviation, correctAnswers, missedClicks, wrongClicks) {
        const login = "<%= login %>";
        const age = userAge;
        const sex = userSex;

        fetch('http://localhost:3000/api/test_color_signal', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                login: login,
                averageReactionTime: averageReactionTime,
                standardDeviation: standardDeviation,
                correctAnswers: correctAnswers,
                missedClicks: missedClicks,
                wrongClicks: wrongClicks,
                age: age,
                sex: sex
            }),
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert("Результаты теста успешно сохранены!");
                } else {
                    alert("Ошибка при сохранении результатов: " + data.message);
                }
            })
            .catch(error => {
                alert("Ошибка сети: " + error.message);
            });
    }

    function finishTest() {
        console.log("Function finishTest called");
        clearTimeout(testTimeout);
        clearTimeout(signalTimeout);
        showResults();

        let averageReactionTime = 0;
        let standardDeviation = 0;

        if (reactionTimes.length > 0) {
            averageReactionTime = reactionTimes.reduce((a, b) => a + b, 0) / reactionTimes.length;
            const variance = reactionTimes.map(x => Math.pow(x - averageReactionTime, 2)).reduce((a, b) => a + b, 0) / reactionTimes.length;
            standardDeviation = Math.sqrt(variance);
        }

        // Проверяем, нужно ли запросить данные пользователя
        if (userAge === null || userSex === null) {
            showUserDataModal(averageReactionTime, standardDeviation, correctAnswers, missedClicks, wrongClicks);
        } else {
            saveTestResults(averageReactionTime, standardDeviation, correctAnswers, missedClicks, wrongClicks);
        }

        resetTest();
    }

    function showUserDataModal(averageReactionTime, standardDeviation, correctAnswers, missedClicks, wrongClicks) {
        const modal = document.getElementById('userDataModal');
        modal.style.display = 'flex';

        // Сохраняем результаты теста для последующего сохранения
        modal.dataset.averageReactionTime = averageReactionTime;
        modal.dataset.standardDeviation = standardDeviation;
        modal.dataset.correctAnswers = correctAnswers;
        modal.dataset.missedClicks = missedClicks;
        modal.dataset.wrongClicks = wrongClicks;
    }

    function saveUserData() {
        const ageInput = document.getElementById('age');
        const sexSelect = document.getElementById('sex');

        if (!ageInput.value || !sexSelect.value) {
            alert("Пожалуйста, заполните все поля");
            return;
        }

        userAge = ageInput.value;
        userSex = sexSelect.value;

        const modal = document.getElementById('userDataModal');
        modal.style.display = 'none';

        // Получаем сохраненные результаты теста
        const averageReactionTime = parseFloat(modal.dataset.averageReactionTime);
        const standardDeviation = parseFloat(modal.dataset.standardDeviation);
        const correctAnswers = parseInt(modal.dataset.correctAnswers);
        const missedClicks = parseInt(modal.dataset.missedClicks);
        const wrongClicks = parseInt(modal.dataset.wrongClicks);

        // Сохраняем результаты с данными пользователя
        saveTestResults(averageReactionTime, standardDeviation, correctAnswers, missedClicks, wrongClicks);
    }

    function resetTest() {
        console.log("Test reset");
        const startButton = document.getElementById('startButton');
        startButton.disabled = false;
        reactionTimes = [];
        correctAnswers = 0;
        missedClicks = 0;
        wrongClicks = 0;
        const signalElement = document.getElementById('signal');
        signalElement.style.backgroundColor = 'transparent';
        const buttons = document.querySelectorAll('.button');
        buttons.forEach(button => button.classList.add('disabled'));
        const resultsDiv = document.getElementById('results');
        resultsDiv.style.display = 'none';
    }

    function startTest() {
        console.log("Test started");
        resetTest();
        const startButton = document.getElementById('startButton');
        startButton.disabled = true;

        const buttons = document.querySelectorAll('.button');
        buttons.forEach(button => {
            button.classList.remove('disabled');
            button.addEventListener('click', function() {
                checkAnswer(this.className.split(' ')[1]);
            });
        });

        startSignal();
        testTimeout = setTimeout(finishTest, 0.3 * 60 * 1000);
    }
</script>
</body>
</html>