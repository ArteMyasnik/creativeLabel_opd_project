<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Тест на чётность суммы</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');

        body {
            text-align: center;
            font-family: Arial, sans-serif;
            margin: 50px;
            background-color: black;
            font-family: Montserrat;
            color: white;
            margin: 0;
            padding: 0;
        }

        .button-container {
            padding-top: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 5px;
            background-repeat: no-repeat;
            font-size: 0;
        }

        .button-container button {
            margin: 0.5rem 0.5rem;
            padding: 0.7rem 2rem;
            font-size: 17px;
            font-family: Montserrat;
            cursor: pointer;
            border: none;
            border-radius: 20px;
            background-color: #479C92;
            color: white;
        }

        .button-container button:hover {
            background-color: #2d5e58;
            transition: all 0.3s ease;
        }

        .left-button {
            margin-right: auto;
        }

        /* Новая секция для кнопок выбора длительности */
        #durationButtons {
            margin-bottom: 20px;
        }
        .durationBtn {
            padding: 10px 20px;
            margin: 5px;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background: #479C92; /* изначально подсвечена */
            color: white;
            transition: background-color 0.3s;
        }
        /* При выборе кнопка становится серой */
        .durationBtn.selected {
            background: gray;
        }
        .numbers {
            font-size: 80px;
            margin: 30px;
            letter-spacing: 20px;
            color: #007ffd;
            min-height: 120px;
            font-family: Montserrat;
        }
        button {
            padding: 15px 30px;
            margin: 10px;
            font-size: 18px;
            cursor: pointer;
            border: none;
            border-radius: 5px;
            font-family: Montserrat;
        }
        #startBtn {
            background: #479C92;
            color: white;
        }
        .answerBtn {
            background: #479C92;
            color: white;
            opacity: 0.5;
            transition: opacity 0.3s;
            display: none;
            font-family: Montserrat;
        }
        .active {
            opacity: 1;
            cursor: pointer;
        }
        #results {
            margin-top: 30px;
            font-size: 18px;
            display: none;
            font-family: Montserrat;
        }
        .disabled{
            opacity:0.5;
        }
        
        /* Стили для виджета приглашения */
        #inviteWidget {
            margin: 40px auto;
            padding: 20px;
            max-width: 600px;
            background: #2c2c2c;
            border-radius: 8px;
            border: 1px solid #479C92;
        }
        #inviteWidget h3 {
            margin-top: 0;
            color: #479C92;
        }
        #inviteLink {
            padding: 12px;
            background: #232323;
            border: 1px solid #479C92;
            border-radius: 4px;
            word-break: break-all;
            margin: 15px 0;
            color: white;
        }
        .share-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .share-button {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-family: Montserrat;
            transition: all 0.3s;
        }
        #copyButton {
            background: #479C92;
            color: white;
        }
        #whatsappButton {
            background: #25D366;
            color: white;
        }
        #telegramButton {
            background: #0088cc;
            color: white;
        }
        .share-button:hover {
            opacity: 0.8;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
<div class="button-container">
    <div class="left-button">
        <button onclick="window.location.href='/main'">Главная страница</button>
    </div>
</div>

<h2>Определите чётность суммы чисел</h2>
<!-- Добавлены кнопки выбора длительности теста -->
<div id="durationButtons">
    <button class="durationBtn" data-duration="30">30 с</button>
    <button class="durationBtn" data-duration="60">60 с</button>
    <button class="durationBtn" data-duration="120">120 с</button>
</div>
<button id="startBtn">Старт</button>
<div class="numbers" id="numbers"></div>
<button class="answerBtn" id="evenBtn">Чётная сумма</button>
<button class="answerBtn" id="oddBtn">Нечётная сумма</button>
<div id="results"></div>

<!-- Виджет для приглашения друзей -->
<div id="inviteWidget">
    <h3>Пригласите друзей на этот тест</h3>
    <p>Ваша персональная ссылка:</p>
    <div id="inviteLink"></div>
    <div class="share-buttons">
        <button id="copyButton" class="share-button">Копировать</button>
        <button id="whatsappButton" class="share-button">WhatsApp</button>
        <button id="telegramButton" class="share-button">Telegram</button>
    </div>
</div>

<script>
    let startTime;
    let reactionTimes = [];
    let correctAnswers = 0;
    let wrongAnswers = 0;
    let missedAttempts = 0;
    let currentNumbers = [0, 0];
    let testActive = false;
    let timeoutId;
    let testTimerId;
    let testDuration = null; // длительность теста в секундах

    const startBtn = document.getElementById('startBtn');
    const numbersElement = document.getElementById('numbers');
    const evenBtn = document.getElementById('evenBtn');
    const oddBtn = document.getElementById('oddBtn');
    const resultsElement = document.getElementById('results');
    const durationButtons = document.querySelectorAll('.durationBtn');

    // Функция для генерации реферальной ссылки
    function generateReferralLink() {
        // Получаем текущий URL теста
        const testUrl = window.location.href.split('?')[0];
        
        // Пытаемся получить ID пользователя из различных источников
        let userId = 'guest';
        
        // Проверка URL параметров
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('ref')) {
            userId = urlParams.get('ref');
        }
        // Проверка cookies
        else if (document.cookie.includes('user_id=')) {
            userId = document.cookie
                .split('; ')
                .find(row => row.startsWith('user_id='))
                .split('=')[1];
        }
        // Проверка localStorage
        else if (localStorage.getItem('user_id')) {
            userId = localStorage.getItem('user_id');
        }
        // Проверка sessionStorage
        else if (sessionStorage.getItem('user_id')) {
            userId = sessionStorage.getItem('user_id');
        }
        
        // Генерируем ссылку с параметрами
        return `${testUrl}?ref=${encodeURIComponent(userId)}&utm_source=referral&utm_medium=social&utm_campaign=evenodd_test`;
    }

    // Функции для работы с реферальными ссылками
    function copyToClipboard() {
        const inviteLink = document.getElementById('inviteLink').textContent;
        navigator.clipboard.writeText(inviteLink)
            .then(() => {
                const button = document.getElementById('copyButton');
                const originalText = button.textContent;
                button.textContent = 'Скопировано!';
                setTimeout(() => {
                    button.textContent = originalText;
                }, 2000);
            })
            .catch(err => {
                console.error('Ошибка копирования:', err);
                // Альтернативный метод для старых браузеров
                const textarea = document.createElement('textarea');
                textarea.value = inviteLink;
                document.body.appendChild(textarea);
                textarea.select();
                try {
                    document.execCommand('copy');
                    const button = document.getElementById('copyButton');
                    const originalText = button.textContent;
                    button.textContent = 'Скопировано!';
                    setTimeout(() => {
                        button.textContent = originalText;
                    }, 2000);
                } catch (err) {
                    alert('Не удалось скопировать ссылку. Пожалуйста, скопируйте вручную.');
                }
                document.body.removeChild(textarea);
            });
    }

    function shareViaWhatsApp() {
        const inviteLink = document.getElementById('inviteLink').textContent;
        const text = `Привет! Попробуй этот тест на определение чётности суммы чисел: ${inviteLink}`;
        window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
    }

    function shareViaTelegram() {
        const inviteLink = document.getElementById('inviteLink').textContent;
        const text = `Привет! Попробуй этот тест на определение чётности суммы чисел: ${inviteLink}`;
        window.open(`https://t.me/share/url?url=${encodeURIComponent(inviteLink)}&text=${encodeURIComponent(text)}`, '_blank');
    }

    // Инициализация виджета приглашения
    function initInviteWidget() {
        const inviteLink = generateReferralLink();
        document.getElementById('inviteLink').textContent = inviteLink;
        
        // Назначаем обработчики для кнопок
        document.getElementById('copyButton').addEventListener('click', copyToClipboard);
        document.getElementById('whatsappButton').addEventListener('click', shareViaWhatsApp);
        document.getElementById('telegramButton').addEventListener('click', shareViaTelegram);
    }

    // Добавляем обработчик для кнопок выбора длительности
    durationButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            durationButtons.forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            testDuration = parseInt(btn.dataset.duration);
        });
    });

    function startTest() {
        if (!testDuration) {
            alert("Пожалуйста, выберите длительность теста");
            return;
        }
        testActive = true;
        startBtn.disabled = true;
        reactionTimes = [];
        correctAnswers = 0;
        wrongAnswers = 0;
        missedAttempts = 0;

        resultsElement.style.display = 'none';
        evenBtn.style.display = 'inline-block';
        oddBtn.style.display = 'inline-block';

        // Запускаем таймер теста на выбранное время
        testTimerId = setTimeout(endTest, testDuration * 1000);

        showNextNumbers();
    }

    function generateNumbers() {
        currentNumbers = [
            Math.floor(Math.random() * 10),
            Math.floor(Math.random() * 10)
        ];
        return currentNumbers;
    }

    function showNextNumbers() {
        if (reactionTimes.length + missedAttempts >= 20) {
            endTest();
            return;
        }

        if (timeoutId) clearTimeout(timeoutId);
        generateNumbers();
        numbersElement.textContent = currentNumbers.join(' ');
        startTime = Date.now();

        evenBtn.classList.add('active');
        oddBtn.classList.add('active');

        timeoutId = setTimeout(() => {
            handleMissedAttempt();
        }, 5000);
    }

    function handleMissedAttempt() {
        if (!testActive) return;

        missedAttempts++;
        numbersElement.textContent = '';
        evenBtn.classList.remove('active');
        oddBtn.classList.remove('active');

        setTimeout(() => {
            showNextNumbers();
        }, 1000);
    }

    function handleAnswer(isEven) {
        if (!testActive || !evenBtn.classList.contains('active')) return;

        clearTimeout(timeoutId);
        const sum = currentNumbers[0] + currentNumbers[1];
        const reactionTime = Date.now() - startTime;
        reactionTimes.push(reactionTime);

        if ((sum % 2 === 0) === isEven) {
            correctAnswers++;
        } else {
            wrongAnswers++;
        }

        numbersElement.textContent = '';
        evenBtn.classList.remove('active');
        oddBtn.classList.remove('active');

        setTimeout(() => {
            showNextNumbers();
        }, 1000);
    }

    function endTest() {
        testActive = false;
        startBtn.disabled = false;
        evenBtn.style.display = 'none';
        oddBtn.style.display = 'none';
        numbersElement.textContent = '';
        if (timeoutId) clearTimeout(timeoutId);
        if (testTimerId) clearTimeout(testTimerId);
        showResults();
    }

    function showResults() {
        const average = reactionTimes.reduce((a, b) => a + b, 0) / reactionTimes.length || 0;
        const variance = reactionTimes.reduce((a, b) => a + Math.pow(b - average, 2), 0) / reactionTimes.length || 0;
        const stdDev = Math.sqrt(variance);
        const totalAttempts = correctAnswers + wrongAnswers + missedAttempts;
        const accuracy = totalAttempts > 0 ? (correctAnswers / totalAttempts) * 100 : 0;

        resultsElement.innerHTML = `
                <h3>Результаты теста:</h3>
                <p>Среднее время реакции: ${average.toFixed(2)} мс</p>
                <p>Стандартное отклонение: ${stdDev.toFixed(2)} мс</p>
                <p>Правильные ответы: ${correctAnswers}</p>
                <p>Ошибки: ${wrongAnswers}</p>
                <p>Пропущенные попытки: ${missedAttempts}</p>
                <p>Точность: ${accuracy.toFixed(1)}%</p>
            `;
        resultsElement.style.display = 'block';

        // Собираем только минимально необходимые данные для отправки
        const testResults = {
            login: "<%= login %>",  // или другой способ получения логина
            reactionTimes: reactionTimes,  // все времена реакций (можно вычислить среднее и отклонение)
            correctAnswers: correctAnswers,  // правильные ответы
            wrongAnswers: wrongAnswers,  // неправильные ответы
            missedAttempts: missedAttempts,  // пропущенные попытки
            testDuration: testDuration  // длительность теста в секундах
        };

        // Отправляем результаты на сервер
        sendResultsToServer(testResults);
    }

    // Функция для отправки результатов на сервер
    function sendResultsToServer(results) {
        // Замените URL на ваш реальный endpoint сервера
        fetch('http://localhost:3000/api/test_digital_signal', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(results),
        })
            .then(response => response.json())
            .then(data => {
                if (data.success === true) {
                    console.log(data.message);
                } else {
                    console.error('Ошибка при сохранении результатов:', data.message);
                    alert('Ошибка при сохранении результатов.');
                }
            })
            .catch(error => {
                console.error('Ошибка:', error);
                alert('Произошла ошибка при отправке результатов.');
            });
    }

    // Инициализация при загрузке страницы
    document.addEventListener('DOMContentLoaded', function() {
        startBtn.addEventListener('click', startTest);
        evenBtn.addEventListener('click', () => handleAnswer(true));
        oddBtn.addEventListener('click', () => handleAnswer(false));
        
        // Инициализируем виджет приглашения
        initInviteWidget();
        
        // Проверяем, пришел ли пользователь по реферальной ссылке
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('ref')) {
            const referrerId = urlParams.get('ref');
            console.log('Пользователь пришел по реферальной ссылке от:', referrerId);
            // Здесь можно отправить информацию о реферере на сервер
        }
    });
</script>
</body>
</html>