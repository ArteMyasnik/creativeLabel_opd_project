<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Статистика цветового сигнала - <%= login %></title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f5f5f5;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
        }
        .stats-container {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            margin: 25px 0;
            gap: 15px;
        }
        .stat-card {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            min-width: 180px;
            text-align: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            border-top: 4px solid #4285F4;
        }
        .stat-value {
            font-size: 26px;
            font-weight: bold;
            margin: 8px 0;
            color: #2c3e50;
        }
        .chart-container {
            height: 500px;
            margin: 30px 0;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
            border-radius: 8px;
        }
        .chart-actions {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
        }
        .chart-btn {
            padding: 8px 15px;
            background: #4285F4;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .no-data {
            text-align: center;
            padding: 40px;
            color: #666;
            font-size: 18px;
        }
        .empty-chart-message {
            text-align: center;
            color: #666;
            font-size: 18px;
            padding: 20px;
        }
        .test-selector {
            margin: 20px 0;
            text-align: center;
        }
        .test-select {
            padding: 8px 15px;
            border-radius: 4px;
            border: 1px solid #ddd;
            min-width: 200px;
        }
        .hidden {
            display: none;
        }
        .test-details {
            margin-top: 20px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
        }
        .accuracy-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            background-color: #e6f4ea;
            color: #34a853;
            font-weight: bold;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>Статистика теста цветового сигнала: <%= login %></h1>

    <% if (noData) { %>
        <div class="no-data">
            <h3>Данные теста отсутствуют</h3>
            <p>Пользователь еще не проходил этот тест или результаты не были сохранены.</p>
            <p>Пройдите тест, чтобы увидеть статистику.</p>
        </div>
    <% } else { %>
        <div class="stats-container">
            <div class="stat-card">
                <h3>Всего тестов</h3>
                <div class="stat-value"><%= stats.totalTests %></div>
            </div>
            <div class="stat-card">
                <h3>Точность</h3>
                <div class="stat-value"><span class="accuracy-badge"><%= stats.totalAccuracy %>%</span></div>
            </div>
            <div class="stat-card">
                <h3>Среднее время</h3>
                <div class="stat-value"><%= stats.avgReaction %> мс</div>
            </div>
            <div class="stat-card">
                <h3>Правильные</h3>
                <div class="stat-value"><%= stats.totalCorrect %></div>
            </div>
            <div class="stat-card">
                <h3>Ошибки</h3>
                <div class="stat-value"><%= stats.totalWrong %></div>
            </div>
            <div class="stat-card">
                <h3>Пропуски</h3>
                <div class="stat-value"><%= stats.totalMissed %></div>
            </div>
        </div>

        <div class="test-selector">
            <select id="testSelect" class="test-select" onchange="updateChart()">
                <option value="all">Все тесты (средние значения)</option>
                <% testsData.forEach(test => { %>
                    <option value="<%= test.testId %>">Тест #<%= test.testNumber %> (<%= new Date(test.createdAt).toLocaleString() %>)</option>
                <% }); %>
            </select>
        </div>

        <div id="selectedTestDetails" class="test-details hidden">
            <h3>Детали теста</h3>
            <p>Дата прохождения: <span id="testDate"></span></p>
            <p>Длительность: <span id="testDuration"></span> сек</p>
            <p>Количество попыток: <span id="testAttempts"></span></p>
            <p>Точность: <span id="testAccuracy" class="accuracy-badge"></span></p>
            <p>Правильные ответы: <span id="testCorrect"></span></p>
            <p>Ошибочные клики: <span id="testWrong"></span></p>
            <p>Пропущенные клики: <span id="testMissed"></span></p>
            <p>Среднее время: <span id="testAvg"></span> мс</p>
            <p>Лучший результат: <span id="testBest"></span> мс</p>
            <p>Худший результат: <span id="testWorst"></span> мс</p>
        </div>

        <div class="chart-actions">
            <button class="chart-btn" onclick="zoomChart(0.9)">- Уменьшить</button>
            <button class="chart-btn" onclick="zoomChart(1.1)">+ Увеличить</button>
            <button class="chart-btn" onclick="resetZoom()">Сбросить</button>
            <button class="chart-btn" onclick="toggleDataset()">Переключить данные</button>
        </div>

        <div class="chart-container">
            <% if (stats.totalAttempts > 0) { %>
                <canvas id="reactionChart"></canvas>
            <% } else { %>
                <div class="empty-chart-message">
                    <h3>Нет данных для построения графика</h3>
                    <p>Хотя тест был начат, не было зарегистрировано ни одной успешной попытки.</p>
                </div>
            <% } %>
        </div>

        <% if (stats.totalAttempts > 0) { %>
            <script>
                // Сохраняем данные тестов для использования в JS
                const testsData = <%- JSON.stringify(testsData) %>;
                let currentChart = null;
                let showAccuracy = false;

                // Функция для получения данных графика
                function getChartData(testId) {
                    if (testId === 'all') {
                        return {
                            labels: testsData.map(test => `Тест ${test.testNumber}`),
                            datasets: [{
                                label: showAccuracy ? 'Точность (%)' : 'Среднее время реакции (мс)',
                                data: showAccuracy
                                    ? testsData.map(test => test.accuracy)
                                    : testsData.map(test => parseFloat(test.avgReaction)),
                                borderColor: showAccuracy ? '#34A853' : '#4285F4',
                                backgroundColor: showAccuracy
                                    ? 'rgba(52, 168, 83, 0.1)'
                                    : 'rgba(66, 133, 244, 0.1)',
                                borderWidth: 2,
                                pointRadius: 5,
                                pointHoverRadius: 8,
                                tension: 0.1,
                                fill: true,
                                yAxisID: showAccuracy ? 'yAccuracy' : 'yReaction'
                            }]
                        };
                    } else {
                        const test = testsData.find(t => t.testId == testId);
                        return {
                            labels: test.reactions.map((_, i) => i + 1),
                            datasets: [{
                                label: 'Время реакции (мс)',
                                data: test.reactions,
                                borderColor: '#4285F4',
                                backgroundColor: 'rgba(66, 133, 244, 0.1)',
                                borderWidth: 2,
                                pointRadius: 3,
                                pointHoverRadius: 6,
                                tension: 0.1,
                                fill: true
                            }]
                        };
                    }
                }

                // Функция переключения между временем реакции и точностью
                window.toggleDataset = function() {
                    showAccuracy = !showAccuracy;
                    updateChart();
                };

                // Функция обновления графика
                window.updateChart = function() {
                    if (!currentChart) return;

                    const testId = document.getElementById('testSelect').value;
                    currentChart.data = getChartData(testId);

                    // Обновляем опции для осей Y в зависимости от типа данных
                    currentChart.options.scales = {
                        yReaction: {
                            display: !showAccuracy,
                            position: 'left',
                            beginAtZero: false,
                            title: { display: true, text: 'Время реакции (мс)' }
                        },
                        yAccuracy: {
                            display: showAccuracy,
                            position: 'left',
                            beginAtZero: false,
                            min: 0,
                            max: 100,
                            title: { display: true, text: 'Точность (%)' }
                        },
                        x: {
                            title: {
                                display: true,
                                text: testId === 'all' ? 'Номер теста' : 'Номер попытки'
                            }
                        }
                    };

                    currentChart.update();

                    // Показываем детали для выбранного теста
                    const detailsDiv = document.getElementById('selectedTestDetails');
                    if (testId === 'all') {
                        detailsDiv.classList.add('hidden');
                    } else {
                        const test = testsData.find(t => t.testId == testId);
                        if (test) {
                            document.getElementById('testDate').textContent = new Date(test.createdAt).toLocaleString();
                            document.getElementById('testDuration').textContent = test.testDuration;
                            document.getElementById('testAttempts').textContent = test.totalReactions;
                            document.getElementById('testAccuracy').textContent = test.accuracy + '%';
                            document.getElementById('testCorrect').textContent = test.correctAnswers;
                            document.getElementById('testWrong').textContent = test.wrongClicks;
                            document.getElementById('testMissed').textContent = test.missedClicks;
                            document.getElementById('testAvg').textContent = test.avgReaction;
                            document.getElementById('testBest').textContent = test.bestReaction;
                            document.getElementById('testWorst').textContent = test.worstReaction;
                            detailsDiv.classList.remove('hidden');
                        }
                    }
                };

                // Функции управления масштабом
                window.zoomChart = function(scale) {
                    if (currentChart) {
                        currentChart.zoom(scale);
                    }
                };

                window.resetZoom = function() {
                    if (currentChart) {
                        currentChart.resetZoom();
                    }
                };

                // Инициализация графика
                document.addEventListener('DOMContentLoaded', function() {
                    const ctx = document.getElementById('reactionChart');
                    if (!ctx) return;

                    currentChart = new Chart(ctx.getContext('2d'), {
                        type: 'line',
                        data: getChartData('all'),
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                zoom: {
                                    zoom: {
                                        wheel: { enabled: true },
                                        pinch: { enabled: true },
                                        mode: 'xy'
                                    },
                                    pan: {
                                        enabled: true,
                                        mode: 'xy'
                                    }
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return `${context.dataset.label}: ${context.parsed.y}` +
                                                (context.dataset.label.includes('Точность') ? '%' : ' мс');
                                        }
                                    }
                                }
                            },
                            scales: {
                                yReaction: {
                                    display: true,
                                    position: 'left',
                                    beginAtZero: false,
                                    title: { display: true, text: 'Время реакции (мс)' }
                                },
                                yAccuracy: {
                                    display: false,
                                    position: 'left',
                                    beginAtZero: false,
                                    min: 0,
                                    max: 100,
                                    title: { display: true, text: 'Точность (%)' }
                                },
                                x: {
                                    title: { display: true, text: 'Номер теста' }
                                }
                            }
                        }
                    });
                });
            </script>
        <% } %>
    <% } %>
</div>
</body>
</html>