<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Профиль</title>
    <link rel="stylesheet" href="../../Styles/profileStyles.css">
</head>
<body>
<button onclick="window.location.href='/main'">Главная страница</button>
<h1>Профиль <%= login %></h1>
<div class="container">

    <div class="myProfile">
        <div class="imageContainer">
            <img src="../../Images/ава.jpg" alt="Аватар">
        </div>
        <h2>Мой профиль</h2>
        <p>Логин: <%= login %></p>
        <p>Почта: <%= email %></p>
        <p>Пол: <%= sex %> <button class="edit-button" onclick="editSex()">Изменить</button></p>
        <p>Возраст: <%= age %> <button class="edit-button" onclick="editAge()">Изменить</button></p>
        <button class="edit-button" onclick="changePassword()">Изменить пароль</button>
    </div>
    <div class="testResults">
        <h2>Результаты тестов</h2>
        <h3>разрабы - вы лучшие!</h3>
        <h4>Section 1</h4>
        <table>
            <thead>
            <tr>
                <th>№</th>
                <th>Тест</th>
                <th>Время прохождения</th>
                <th>Кол-во попыток</th>
                <th>Результат</th>
                <th>Закладки</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>1</td>
                <td>Тест 1</td>
                <td>10:00</td>
                <td>2</td>
                <td>80%</td>
                <td><button>добавить в закладку</button></td>
            </tr>
            </tbody>
        </table>
    </div>
    <div class="appearanceSettings">
        <h2>Настройки внешнего вида</h2>
        <div class="appearanceOptions">
            <div class="option" onclick="toggleDropdown('hat')">
                <button class="squareButton">Головной убор</button>
                <div class="dropdownContent" id="hatDropdown">
                    <button class="squareButton">Головной убор 1</button>
                    <button class="squareButton">Головной убор 2</button>
                    <button class="squareButton">Головной убор 3</button>
                </div>
            </div>
            <div class="option" onclick="toggleDropdown('clothes')">
                <button class="squareButton">Одежда</button>
                <div class="dropdownContent" id="clothesDropdown">
                    <button class="squareButton">Одежда 1</button>
                    <button class="squareButton">Одежда 2</button>
                    <button class="squareButton">Одежда 3</button>
                </div>
            </div>
            <div class="option" onclick="toggleDropdown('accessories')">
                <button class="squareButton">Аксессуары</button>
                <div class="dropdownContent" id="accessoriesDropdown">
                    <button class="squareButton">Аксессуар 1</button>
                    <button class="squareButton">Аксессуар 2</button>
                    <button class="squareButton">Аксессуар 3</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleDropdown(id) {
        const dropdowns = document.querySelectorAll('.dropdownContent');
        const currentDropdown = document.getElementById(id + 'Dropdown');

        dropdowns.forEach(dropdown => {
            if (dropdown !== currentDropdown) {
                dropdown.style.display = 'none';
            }
        });

        if (currentDropdown.style.display === 'flex') {
            currentDropdown.style.display = 'none';
        } else {
            currentDropdown.style.display = 'flex';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const profileLogin = "<%= login %>"; // Логин профиля, который просматривается

        // Проверка статуса авторизации
        fetch('http://localhost:3000/check-auth')
            .then(response => response.json())
            .then(data => {
                if (data.login !== profileLogin) {
                    // Если логин не совпадает, скрываем кнопки редактирования
                    const editButtons = document.querySelectorAll('.edit-button');
                    editButtons.forEach(button => {
                        button.style.display = 'none';
                    });
                }
            })
            .catch(error => {
                console.error('Ошибка при проверке авторизации:', error);
            });
    });

