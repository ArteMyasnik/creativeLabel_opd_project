<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Профиль <%= login %></title>
    <link rel="stylesheet" href="../../Styles/profileStyles.css">
    <style>
        .hidden {
            display: none;
        }
    </style>
</head>
<body>
<button onclick="window.location.href='/main'">Главная страница</button>
<h1>Профиль <%= login %></h1>
<div class="container">

    <div class="myProfile">
        <div class="imageContainer">
            <img src="../../Images/ава.jpg" alt="Аватар">
        </div>
        <h2>Мой профиль</h2>
        <p>Логин: <%= login %></p>
        <p>Почта: <%= email %></p>
        <p>Пол: <%= sex || 'Не указан' %> <button class="edit-button" onclick="editSex()">Изменить</button></p>
        <p>Возраст: <%= age || 'Не указан' %> <button class="edit-button" onclick="editAge()">Изменить</button></p>
        <button class="edit-button" onclick="changePassword()">Изменить пароль</button>
    </div>
    <div class="testResults">
        <h2>Результаты тестов</h2>
        <% if (!age || !sex) { %>
            <div class="missing-info-message">
                <p>Введите возраст и пол, чтобы увидеть результаты</p>
            </div>
        <% } else { %>
            <div class="test-results-content">
                <h3>разрабы - вы лучшие!</h3>
                <h4>Section 1</h4>
                <table>
                    <thead>
                    <tr>
                        <th>№</th>
                        <th>Тест</th>
                        <th>Время прохождения</th>
                        <th>Кол-во попыток</th>
                        <th>Результат</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>1</td>
                        <td>Тест 1</td>
                        <td>10:00</td>
                        <td>2</td>
                        <td>80%</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
    <div class="appearanceSettings">
        <h2>Настройки внешнего вида</h2>
        <div class="appearanceOptions">
            <div class="option" onclick="toggleDropdown('hat')">
                <button class="squareButton">Головной убор</button>
                <div class="dropdownContent" id="hatDropdown">
                    <button class="squareButton">Головной убор 1</button>
                    <button class="squareButton">Головной убор 2</button>
                    <button class="squareButton">Головной убор 3</button>
                </div>
            </div>
            <div class="option" onclick="toggleDropdown('clothes')">
                <button class="squareButton">Одежда</button>
                <div class="dropdownContent" id="clothesDropdown">
                    <button class="squareButton">Одежда 1</button>
                    <button class="squareButton">Одежда 2</button>
                    <button class="squareButton">Одежда 3</button>
                </div>
            </div>
            <div class="option" onclick="toggleDropdown('accessories')">
                <button class="squareButton">Аксессуары</button>
                <div class="dropdownContent" id="accessoriesDropdown">
                    <button class="squareButton">Аксессуар 1</button>
                    <button class="squareButton">Аксессуар 2</button>
                    <button class="squareButton">Аксессуар 3</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleDropdown(id) {
        const dropdowns = document.querySelectorAll('.dropdownContent');
        const currentDropdown = document.getElementById(id + 'Dropdown');

        dropdowns.forEach(dropdown => {
            if (dropdown !== currentDropdown) {
                dropdown.style.display = 'none';
            }
        });

        if (currentDropdown.style.display === 'flex') {
            currentDropdown.style.display = 'none';
        } else {
            currentDropdown.style.display = 'flex';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const profileLogin = "<%= login %>"; // Логин профиля, который просматривается

        // Проверка статуса авторизации
        fetch('http://localhost:3000/check-auth')
            .then(response => response.json())
            .then(data => {
                if (data.login !== profileLogin) {
                    // Если логин не совпадает, скрываем кнопки редактирования
                    const editButtons = document.querySelectorAll('.edit-button');
                    editButtons.forEach(button => {
                        button.style.display = 'none';
                    });
                }
            })
            .catch(error => {
                console.error('Ошибка при проверке авторизации:', error);
            });
    });

    function editSex() {
        const login = "<%= login %>";
        const newSex = prompt("Введите пол(male/female):");
        if (newSex) {
            // Отправка запроса на сервер для изменения пола
            fetch(`http://localhost:3000/api/profile/${login}/update-sex`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ sex: newSex }),
            }).then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert("Пол успешно изменен!");
                        window.location.reload();
                    } else {
                        alert("Ошибка при изменении пола.");
                    }
                });
        }
    }

    function editAge() {
        const login = "<%= login %>";
        const newAge = prompt("Введите новый возраст:");
        if (newAge) {
            // Отправка запроса на сервер для изменения возраста
            fetch(`http://localhost:3000/api/profile/${login}/update-age`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ age: newAge }),
            }).then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert("Возраст успешно изменен!");
                        window.location.reload();
                    } else {
                        alert("Ошибка при изменении возраста.");
                    }
                });
        }
    }

    function changePassword() {
        const login = "<%= login %>";
        const oldPassword = prompt("Введите старый пароль:");
        const newPassword = prompt("Введите новый пароль:");
        const confirmNewPassword = prompt("Введите новый пароль ещё раз:");
        if (oldPassword && newPassword && confirmNewPassword) {
            // Отправка запроса на сервер для изменения пароля
            fetch(`http://localhost:3000/api/profile/${login}/update-password`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ oldPassword: oldPassword, newPassword: newPassword, confirmNewPassword: confirmNewPassword }),
            }).then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert("Пароль успешно изменен!");
                        window.location.reload();
                    } else {
                        alert("Ошибка при изменении пароля.");
                    }
                });
        }
    }
</script>
</body>
</html>