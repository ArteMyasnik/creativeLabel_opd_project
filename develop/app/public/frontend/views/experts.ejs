<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Список экспертов</title>
    <link rel="stylesheet" href="../../Styles/expertStyles.css" />
</head>
<body>
<div class="button-container">
    <div class="left-button">
        <button onclick="window.location.href='/main'">Главная страница</button>
    </div>
    <div class="right-buttons">
        <button onclick="window.location.href='/profile'">Профиль</button>
        <button id="loginButton" onclick="window.location.href='/login'">Войти</button>
    </div>
</div>

<div class="content">
    <h1>Список экспертов</h1>

    <div class="experts-row">
        <% users.forEach(function(user) { %>
            <div class="expert-card">
                <img src="..\Images/developer.jpg" alt="Эксперт <%= user.id %>">
                <div class="expert-name"><%= user.login %></div>
                <button class="assign-button" userLogin="<%= user.login %>">Назначить экспертом</button>
            </div>
        <% }); %>
    </div>
    <button id="reset-experts-button">Сбросить экспертов</button>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const buttons = document.querySelectorAll('.assign-button');

        // Функция для отправки запроса на сервер
        function assignExpert(userLogin) {
            fetch('http://localhost:3000/api/experts', {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ login: userLogin }), // Отправляем login на сервер
            })
                .then(response => response.json()) // Парсим ответ от сервера
                .then(data => {
                    if (data.message === 'Пользователь назначен экспертом') {
                        alert(`Пользователь с login ${userLogin} назначен экспертом.`);
                        window.location.reload(); // Обновляем страницу для отображения изменений
                    } else {
                        alert('Ошибка при назначении эксперта.');
                    }
                })
                .catch(error => {
                    console.error('Ошибка:', error);
                    alert('Произошла ошибка при отправке запроса.');
                });
        }

        buttons.forEach(button => {
            button.addEventListener('click', function () {
                const userLogin = this.getAttribute('userLogin');
                assignExpert(userLogin); // Вызов функции для назначения эксперта
            });
        });


    });
    const isLoggedIn = sessionStorage.getItem('isLoggedIn');
    const loginButton = document.getElementById('loginButton');
    if (isLoggedIn) {
        loginButton.style.display = 'none';
    }
</script>
</body>
</html>