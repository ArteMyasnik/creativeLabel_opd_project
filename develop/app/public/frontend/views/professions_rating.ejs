<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Создание профессии</title>
    <link rel="stylesheet" href="../../Styles/professionsRatingStyles.css"/>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <style>
    </style>
</head>
<body>
<div class="button-container">
    <div class="left-button">
        <button onclick="window.location.href='/main'">Главная страница</button>
    </div>
</div>

<div class="center-buttons">
    <% const cardCount = Math.max(3, professions.length + 1); %>
    <% for (let i = 0; i < cardCount; i++) { %>
        <div class="button-group">
            <% if (i < professions.length) { %>
                <!-- Карточка существующей профессии -->
                <button class="make_button profession-card"
                        id="professionButton<%= i + 1 %>"
                        onclick="selectExistingProfession(
                                '<%= professions[i].id %>',
                                '<%= professions[i].name %>',
                                '<%= professions[i].description %>',
                                'professionButton<%= i + 1 %>'
                                )">
                    <div class="profession-title"><%= professions[i].name %></div>
                    <% if (professions[i].description) { %>
                        <div class="profession-description"><%= professions[i].description %></div>
                    <% } %>
                </button>
            <% } else { %>
                <!-- Кнопка создания новой профессии -->
                <button class="make_button"
                        id="professionButton<%= i + 1 %>"
                        onclick="openNewProfessionModal('professionButton<%= i + 1 %>')">
                    Создать профессию
                </button>
            <% } %>

            <!-- Кнопка оценки -->
            <button id='evaluationButton<%= i + 1 %>'
                    class="evaluation-button"
                    onclick="toggleEvaluationList('evaluationList<%= i + 1 %>')"
                    style="display: none">
                Провести оценку
            </button>

            <!-- Список PVK -->
            <div id="evaluationList<%= i + 1 %>" class="evaluation-list">
                <% pvks.forEach(function(pvk) { %>
                    <label>
                        <input type="checkbox"
                               data-pvk-id="<%= pvk.id %>"
                               data-pvk-name="<%= pvk.pvk %>">
                        <%= pvk.pvk %>
                    </label>
                <% }); %>
                <button class="save-selection-button"
                        onclick="saveSelection('professionButton<%= i + 1 %>')">
                    Сохранить выбор
                </button>
            </div>
        </div>
    <% } %>
</div>

<!-- Модальное окно для упорядочивания качеств -->
<div id="orderModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeOrderModal()">&times;</span>
        <h2>Упорядочить выбранные качества</h2>
        <ul id="orderedList" class="sortable-list">
            <!-- Сюда будут добавляться выбранные качества -->
        </ul>
        <button onclick="saveOrder()">Сохранить порядок</button>
    </div>
</div>

<!-- Модальное окно для создания профессии -->
<div id="professionModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeProfessionModal()">&times;</span>
        <h2 id="modalTitle">Создание профессии</h2>
        <input type="text" id="professionName" placeholder="Название профессии">
        <textarea id="professionDescription" placeholder="Краткое описание"></textarea>
        <button onclick="handleProfessionSave()">Сохранить</button>
    </div>
</div>


<script>
    let currentProfession = {
        id: null,
        name: '',
        description: '',
        buttonId: null,
        isNew: false
    };

    document.addEventListener('DOMContentLoaded', function () {
        // Инициализация Sortable для всех списков
        const lists = document.querySelectorAll('.sortable-list');
        lists.forEach(list => {
            new Sortable(list, {
                animation: 150,
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                dragClass: 'sortable-drag',
            });
        });

        // Проверка статуса авторизации
        fetch('http://localhost:3000/check-auth')
            .then(response => response.json())
            .then(data => {
                if (data.isAdmin || data.isExpert) {
                    const evaluationButtons = document.querySelectorAll('.evaluation-button');
                    evaluationButtons.forEach(button => button.style.display = 'block');
                }
            })
            .catch(error => console.error('Ошибка при проверке авторизации:', error));
    });

    let currentButtonId = null;
    let selectedProfessionId = null; // Для существующих профессий
    let professionName = '';
    let professionDescription = '';

    // При выборе профессии из списка
    function selectProfession(professionId, name) {
        selectedProfessionId = professionId;
        professionName = name;
    }

    function openModal(buttonId) {
        currentButtonId = buttonId;
        document.getElementById('myModal').style.display = 'block';
    }

    function closeModal() {
        document.getElementById('myModal').style.display = 'none';
    }

    function openOrderModal(qualities) {
        const orderedList = document.getElementById('orderedList');
        orderedList.innerHTML = ''; // Очищаем список

        qualities.forEach(quality => {
            const li = document.createElement('li');
            li.textContent = quality.text; // Используем название PVK
            orderedList.appendChild(li);
        });

        // Инициализация Sortable для нового списка
        new Sortable(orderedList, {
            animation: 150,
            ghostClass: 'sortable-ghost',
            chosenClass: 'sortable-chosen',
            dragClass: 'sortable-drag',
        });

        document.getElementById('orderModal').style.display = 'block';
    }

    function closeOrderModal() {
        document.getElementById('orderModal').style.display = 'none';
    }

    function saveProfession() {
        const name = document.getElementById('professionName').value.trim();
        const description = document.getElementById('professionDescription').value.trim();

        if (!name || !description) {
            alert('Заполните все поля!');
            return;
        }

        if (name && description) {
            const button = document.getElementById(currentButtonId);
            button.innerHTML = `<strong>${name}</strong><div class="profession-info">${description}</div>`;
            professionName = name;
            professionDescription = description;
            closeModal();
        } else {
            alert('Пожалуйста, заполните все поля.');
        }
    }

    function saveOrder() {
        const orderedList = document.getElementById('orderedList');
        const items = orderedList.querySelectorAll('li');
        const finalOrder = [];

        // Начинаем с 10 и уменьшаем на 1 для каждого следующего элемента
        let mark = 10;

        items.forEach((item) => {
            finalOrder.push({
                pvkName: item.textContent.trim(), // Сохраняем название PVK
                mark: mark // Оценка, начиная с 10 и уменьшаясь на 1
            });
            mark--; // Уменьшаем оценку для следующего элемента
        });

        alert('Порядок сохранен:\n' + finalOrder.map(q => `${q.mark}. ${q.pvkName}`).join('\n'));
        saveResults(finalOrder);
        closeOrderModal();
    }

    function toggleEvaluationList(listId) {
        const list = document.getElementById(listId);
        list.style.display = list.style.display === 'block' ? 'none' : 'block';
    }

    function saveSelection(listId) {
        const list = document.getElementById(listId);
        const items = list.querySelectorAll('label');
        const selectedQualities = [];

        items.forEach((item) => {
            const checkbox = item.querySelector('input[type="checkbox"]');
            if (checkbox.checked) {
                selectedQualities.push({
                    text: checkbox.nextSibling.textContent.trim() // Сохраняем название PVK
                });
            }
        });

        openOrderModal(selectedQualities);
    }

    window.onclick = function (event) {
        const modal = document.getElementById('myModal');
        if (event.target === modal) {
            closeModal();
        }
    }


    // Выбор существующей профессии
    function selectExistingProfession(id, name, description, buttonId) {
        currentProfession = {
            id: id,
            name: name,
            description: description,
            buttonId: buttonId,
            isNew: false
        };

        // Обновляем UI
        document.querySelectorAll('.make_button').forEach(btn =>
            btn.classList.remove('selected-profession'));
        document.getElementById(buttonId).classList.add('selected-profession');

        // Блокируем поля ввода
        document.getElementById('professionName').disabled = true;
        document.getElementById('professionDescription').disabled = true;
    }

    // Открытие модалки для новой профессии
    function openNewProfessionModal(buttonId) {
        currentProfession = {
            id: null,
            name: '',
            description: '',
            buttonId: buttonId,
            isNew: true
        };

        // Сброс полей
        document.getElementById('professionName').value = '';
        document.getElementById('professionDescription').value = '';
        document.getElementById('professionName').disabled = false;
        document.getElementById('professionDescription').disabled = false;

        document.getElementById('professionModal').style.display = 'block';
    }

    // Сохранение профессии
    function handleProfessionSave() {
        const name = document.getElementById('professionName').value.trim();
        const description = document.getElementById('professionDescription').value.trim();

        if (!name) {
            alert('Название профессии обязательно!');
            return;
        }

        if (currentProfession.isNew && !description) {
            alert('Для новой профессии необходимо описание!');
            return;
        }

        // Обновляем кнопку
        const button = document.getElementById(currentProfession.buttonId);
        button.innerHTML = `
            <div class="profession-card">
                <div class="profession-title">${name}</div>
                ${description ? `<div class="profession-description">${description}</div>` : ''}
            </div>
        `;

        currentProfession.name = name;
        currentProfession.description = description;

        closeProfessionModal();
    }

    // Сохранение оценки
    function saveResults(finalOrder) {
        if (!currentProfession.id && !currentProfession.name) {
            alert('Сначала выберите или создайте профессию!');
            return;
        }

        const dataToSend = {
            existing_profession_id: currentProfession.id,
            new_profession: currentProfession.isNew ? {
                name: currentProfession.name,
                description: currentProfession.description
            } : null,
            login: "<%= login %>",
            finalOrder: finalOrder
        };

        console.log("Отправка данных:", dataToSend);

        fetch('http://localhost:3000/api/profession_rating', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(dataToSend)
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Оценки успешно сохранены!');
                    // Сброс выбора
                    currentProfession = { id: null, name: '', description: '', buttonId: null, isNew: false };
                    document.querySelectorAll('.make_button').forEach(btn =>
                        btn.classList.remove('selected-profession'));
                } else {
                    throw new Error(data.message || 'Ошибка сохранения');
                }
            })
            .catch(error => {
                console.error('Ошибка:', error);
                alert('Ошибка: ' + error.message);
            });
    }
    // // При сохранении оценки
    // function saveResults(finalOrder) {
    //     const dataToSend = {
    //         existing_profession_id: selectedProfessionId,
    //         new_profession_name: professionName,
    //         new_profession_description: professionDescription,
    <!--        login: "<%= login %>",-->
