<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Оценка профессий</title>
    <link rel="stylesheet" href="../../Styles/professionsRatingStyles.css"/>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <style>
        .pvk-label {
            display: block;
            margin: 5px 0;
            transition: all 0.3s ease;
        }
        .pvk-label.hidden {
            display: none;
        }
        .checkbox-counter {
            margin: 10px 0;
            font-weight: bold;
            font-size: 14px;
        }
        .checkbox-counter span {
            color: green;
        }
        .checkbox-counter .limit-reached {
            color: red;
        }
        .checkbox-controls {
            margin-top: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }
        .evaluation-list {
            margin-bottom: 10px;
        }
        .profession-card {
            text-align: center;
            padding: 15px;
            background-color: #f8f9fa;
            border-radius: 5px;
            margin-bottom: 10px;
            border: 1px solid #ddd;
            cursor: pointer;
        }
        .profession-title {
            font-weight: bold;
            margin-bottom: 5px;
        }
        .profession-description {
            font-size: 0.9em;
            color: #555;
        }
        .make_button {
            width: 100%;
            padding: 15px;
            margin-bottom: 10px;
            background-color: #f8f9fa;
            border: 1px solid #ddd;
            border-radius: 5px;
            cursor: pointer;
        }
        .evaluation-button {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            background-color: #4a90e2;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .button-group {
            width: 30%;
            margin: 0 1.5%;
            display: inline-block;
            vertical-align: top;
        }
        .center-buttons {
            text-align: center;
            margin: 20px auto;
            width: 90%;
        }
        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.4);
        }
        .modal-content {
            background-color: #fefefe;
            margin: 15% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
            max-width: 600px;
        }
        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }
        .selected-profession {
            background-color: #d4edda;
            border-color: #c3e6cb;
        }
    </style>
</head>
<body>
<div class="button-container">
    <div class="left-button">
        <button onclick="window.location.href='/main'">Главная страница</button>
    </div>
</div>

<%
// Рассчитываем сколько нужно блоков создания
const createBlocksNeeded = professions.length < 3 ? 3 - professions.length : 1;
const totalBlocks = professions.length + createBlocksNeeded;
const rowsNeeded = Math.ceil(totalBlocks / 3);
%>

<% for (let row = 0; row < rowsNeeded; row++) { %>
    <div class="center-buttons">
        <%
            const startIndex = row * 3;
            const endIndex = Math.min(startIndex + 3, totalBlocks);

        for (let i = startIndex; i < endIndex; i++) {
        if (i < professions.length) {
            // Блок существующей профессии
            const profession = professions[i]; %>
        <div class="button-group">
            <div class="make_button profession-card"
                 onclick="selectExistingProfession(
                         '<%= profession.id %>',
                         '<%= profession.name.replace(/'/g, "\\'") %>',
                         '<%= profession.description ? profession.description.replace(/'/g, "\\'") : "" %>',
                         'professionButton<%= i + 1 %>')">
                <div class="profession-title"><%= profession.name %></div>
                <% if (profession.description) { %>
                    <div class="profession-description"><%= profession.description %></div>
                <% } %>
            </div>

            <button id='evaluationButton<%= i + 1 %>'
                    class="evaluation-button"
                    onclick="toggleEvaluationList('evaluationList<%= i + 1 %>', 'checkboxControls<%= i + 1 %>')">
                Провести оценку
            </button>

            <div id="evaluationList<%= i + 1 %>" class="evaluation-list" style="display: none">
                <% pvks.forEach(function(pvk) { %>
                    <label class="pvk-label">
                        <input type="checkbox"
                               data-pvk-id="<%= pvk.id %>"
                               data-pvk-name="<%= pvk.pvk %>"
                               onchange="handleCheckboxChange('checkboxControls<%= i + 1 %>')">
                        <%= pvk.pvk %>
                    </label>
                <% }); %>
            </div>

            <div id="checkboxControls<%= i + 1 %>" class="checkbox-controls" style="display: none">
                <div class="checkbox-counter">Выбрано: <span>0</span>/10</div>
                <button class="save-selection-button"
                        onclick="saveSelection('professionButton<%= i + 1 %>', 'evaluationList<%= i + 1 %>', 'checkboxControls<%= i + 1 %>')">
                    Сохранить выбор
                </button>
            </div>
        </div>
        <% } else {
            // Блок создания новой профессии
            const blockIndex = i - professions.length + 1; %>
        <div class="button-group">
            <button class="make_button"
                    id="professionButton<%= i + 1 %>"
                    onclick="openNewProfessionModal('professionButton<%= i + 1 %>')">
                Создать профессию
            </button>

            <button id='evaluationButton<%= i + 1 %>'
                    class="evaluation-button"
                    onclick="toggleEvaluationList('evaluationList<%= i + 1 %>', 'checkboxControls<%= i + 1 %>')"
                    style="display: none">
                Провести оценку
            </button>

            <div id="evaluationList<%= i + 1 %>" class="evaluation-list" style="display: none">
                <% pvks.forEach(function(pvk) { %>
                    <label class="pvk-label">
                        <input type="checkbox"
                               data-pvk-id="<%= pvk.id %>"
                               data-pvk-name="<%= pvk.pvk %>"
                               onchange="handleCheckboxChange('checkboxControls<%= i + 1 %>')">
                        <%= pvk.pvk %>
                    </label>
                <% }); %>
            </div>

            <div id="checkboxControls<%= i + 1 %>" class="checkbox-controls" style="display: none">
                <div class="checkbox-counter">Выбрано: <span>0</span>/10</div>
                <button class="save-selection-button"
                        onclick="saveSelection('professionButton<%= i + 1 %>', 'evaluationList<%= i + 1 %>', 'checkboxControls<%= i + 1 %>')">
                    Сохранить выбор
                </button>
            </div>
        </div>
        <% } %>
        <% } %>
    </div>
<% } %>

<!-- Модальные окна -->
<div id="professionModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeProfessionModal()">&times;</span>
        <h2>Создание профессии</h2>
        <input type="text" id="professionName" placeholder="Название профессии" required>
        <textarea id="professionDescription" placeholder="Краткое описание" required></textarea>
        <button onclick="handleProfessionSave()">Сохранить</button>
    </div>
</div>

<div id="orderModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeOrderModal()">&times;</span>
        <h2>Упорядочить выбранные качества</h2>
        <ul id="orderedList" class="sortable-list">
            <!-- Сюда будут добавляться выбранные качества -->
        </ul>
        <button onclick="saveOrder()">Сохранить порядок</button>
    </div>
</div>

<script>
    let currentlyOpenListId = null;
    let currentlyOpenControlsId = null;
    let currentProfession = {
        id: null,
        name: '',
        description: '',
        buttonId: null,
        isNew: false
    };

    function handleCheckboxChange(controlsId) {
        const controls = document.getElementById(controlsId);
        const listId = controlsId.replace('checkboxControls', 'evaluationList');
        const list = document.getElementById(listId);
        const checkboxes = list.querySelectorAll('input[type="checkbox"]');
        const checked = list.querySelectorAll('input[type="checkbox"]:checked');
        const counter = controls.querySelector('.checkbox-counter span');
        const MAX_SELECTION = 10;

        counter.textContent = checked.length;

        if (checked.length >= MAX_SELECTION) {
            checkboxes.forEach(checkbox => {
                if (!checkbox.checked) {
                    checkbox.closest('.pvk-label').classList.add('hidden');
                }
            });
            counter.classList.add('limit-reached');
        } else if (checked.length <= 9) {
            checkboxes.forEach(checkbox => {
                checkbox.closest('.pvk-label').classList.remove('hidden');
            });
            counter.classList.remove('limit-reached');
        }
    }

    function toggleEvaluationList(listId, controlsId) {
        const list = document.getElementById(listId);
        const controls = document.getElementById(controlsId);

        if (currentlyOpenListId === listId) {
            list.style.display = 'none';
            controls.style.display = 'none';
            currentlyOpenListId = null;
            currentlyOpenControlsId = null;
            return;
        }

        if (currentlyOpenListId) {
            const prevList = document.getElementById(currentlyOpenListId);
            const prevControls = document.getElementById(currentlyOpenControlsId);
            if (prevList && prevControls) {
                prevList.style.display = 'none';
                prevControls.style.display = 'none';
                prevList.querySelectorAll('.pvk-label').forEach(label => {
                    label.classList.remove('hidden');
                });
                prevList.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                prevControls.querySelector('.checkbox-counter span').textContent = '0';
                prevControls.querySelector('.checkbox-counter span').classList.remove('limit-reached');
            }
        }

        list.style.display = 'block';
        controls.style.display = 'flex';
        currentlyOpenListId = listId;
        currentlyOpenControlsId = controlsId;

        list.querySelectorAll('.pvk-label').forEach(label => {
            label.classList.remove('hidden');
        });
        list.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
        controls.querySelector('.checkbox-counter span').textContent = '0';
        controls.querySelector('.checkbox-counter span').classList.remove('limit-reached');
    }

    function selectExistingProfession(id, name, description, buttonId) {
        currentProfession = {
            id: id,
            name: name,
            description: description,
            buttonId: buttonId,
            isNew: false
        };

        document.querySelectorAll('.make_button').forEach(btn => {
            btn.classList.remove('selected-profession');
        });
        document.getElementById(buttonId).classList.add('selected-profession');

        if (currentlyOpenListId) {
            document.getElementById(currentlyOpenListId).style.display = 'none';
            document.getElementById(currentlyOpenControlsId).style.display = 'none';
            currentlyOpenListId = null;
            currentlyOpenControlsId = null;
        }
    }

    function openNewProfessionModal(buttonId) {
        currentProfession = {
            id: null,
            name: '',
            description: '',
            buttonId: buttonId,
            isNew: true
        };

        document.getElementById('professionName').value = '';
        document.getElementById('professionDescription').value = '';
        document.getElementById('professionModal').style.display = 'block';

        if (currentlyOpenListId) {
            document.getElementById(currentlyOpenListId).style.display = 'none';
            document.getElementById(currentlyOpenControlsId).style.display = 'none';
            currentlyOpenListId = null;
            currentlyOpenControlsId = null;
        }
    }

    function handleProfessionSave() {
        const name = document.getElementById('professionName').value.trim();
        const description = document.getElementById('professionDescription').value.trim();

        if (!name) {
            alert('Название профессии обязательно!');
            return;
        }

        if (currentProfession.isNew && !description) {
            alert('Для новой профессии необходимо описание!');
            return;
        }

        const button = document.getElementById(currentProfession.buttonId);
        button.innerHTML = `
            <div class="profession-title">${name}</div>
            ${description ? `<div class="profession-description">${description}</div>` : ''}
        `;
        button.classList.add('profession-card');
        button.classList.add('selected-profession');

        // Показываем кнопку оценки
        const evalButtonId = currentProfession.buttonId.replace('professionButton', 'evaluationButton');
        document.getElementById(evalButtonId).style.display = 'block';

        currentProfession.name = name;
        currentProfession.description = description;

        closeProfessionModal();
    }

    function saveSelection(buttonId, listId, controlsId) {
        const list = document.getElementById(listId);
        const controls = document.getElementById(controlsId);
        const checkboxes = list.querySelectorAll('input[type="checkbox"]:checked');

        if (checkboxes.length === 0) {
            alert('Выберите хотя бы одно качество!');
            return;
        }

        const selectedQualities = [];
        checkboxes.forEach(checkbox => {
            selectedQualities.push({
                text: checkbox.parentElement.textContent.trim(),
                id: checkbox.dataset.pvkId
            });
        });

        resetCheckboxList(listId, controlsId);
        openOrderModal(selectedQualities);
    }

    function resetCheckboxList(listId, controlsId) {
        const list = document.getElementById(listId);
        const controls = document.getElementById(controlsId);

        list.style.display = 'none';
        controls.style.display = 'none';
        currentlyOpenListId = null;
        currentlyOpenControlsId = null;

        list.querySelectorAll('.pvk-label').forEach(label => {
            label.classList.remove('hidden');
        });
        list.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
        controls.querySelector('.checkbox-counter span').textContent = '0';
        controls.querySelector('.checkbox-counter span').classList.remove('limit-reached');
    }

    function openOrderModal(qualities) {
        const orderedList = document.getElementById('orderedList');
        orderedList.innerHTML = '';

        qualities.forEach(quality => {
            const li = document.createElement('li');
            li.textContent = quality.text;
            li.dataset.pvkId = quality.id;
            orderedList.appendChild(li);
        });

        new Sortable(orderedList, {
            animation: 150,
            ghostClass: 'sortable-ghost',
            chosenClass: 'sortable-chosen',
            dragClass: 'sortable-drag',
        });

        document.getElementById('orderModal').style.display = 'block';
    }

    function closeOrderModal() {
        document.getElementById('orderModal').style.display = 'none';
    }

    function closeProfessionModal() {
        document.getElementById('professionModal').style.display = 'none';
    }

    function saveOrder() {
        const orderedList = document.getElementById('orderedList');
        const items = orderedList.querySelectorAll('li');
        const finalOrder = [];

        let mark = 10;

        items.forEach((item) => {
            finalOrder.push({
                pvkName: item.textContent.trim(),
                mark: mark
            });
            mark--;
        });

        alert('Порядок сохранен:\n' + finalOrder.map(q => `${q.mark}. ${q.pvkName}`).join('\n'));
        saveResults(finalOrder);
        closeOrderModal();
    }

    function saveResults(finalOrder) {
        if (!currentProfession.id && !currentProfession.name) {
            alert('Сначала выберите или создайте профессию!');
            return;
        }

        const dataToSend = {
            existing_profession_id: currentProfession.id,
            new_profession: currentProfession.isNew ? {
                name: currentProfession.name,
                description: currentProfession.description
            } : null,
            login: "<%= login %>",
            finalOrder: finalOrder
        };

        fetch('http://localhost:3000/api/profession_rating', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(dataToSend)
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Оценки успешно сохранены!');
                    if (currentProfession.isNew) {
                        window.location.reload();
                    }
                } else {
                    throw new Error(data.message || 'Ошибка сохранения');
                }
            })
            .catch(error => {
                console.error('Ошибка:', error);
                alert('Ошибка: ' + error.message);
            });
    }

    window.onclick = function(event) {
        const modals = document.querySelectorAll('.modal');
        modals.forEach(modal => {
            if (event.target === modal) {
                if (modal.id === 'orderModal') closeOrderModal();
                if (modal.id === 'professionModal') closeProfessionModal();
            }
        });
    }
</script>
</body>
</html>