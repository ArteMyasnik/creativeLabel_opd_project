<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Статистика по профессии</title>
    <link rel="stylesheet" href="../../Styles/resultsStyles.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
<div class="button-container">
    <div class="left-button">
        <button onclick="window.location.href='/main'">Главная страница</button>
    </div>
</div>

<div class="content">
    <h1>Статистика по профессиям</h1>

    <% professions.forEach(function(profession) { %>
        <!-- Блок для Профессии -->
        <div class="profession-block">
            <!-- Левая часть: диаграмма -->
            <div class="profession-chart">
                <canvas id="professionChart<%= profession.id %>"></canvas>
            </div>

            <!-- Правая часть: описание профессии -->
            <div class="profession-details">
                <h2><%= profession.name %></h2>
                <img src="../Images/developer.jpg" alt="<%= profession.name %>" class="profession-image">
                <p><%= profession.description %></p>
            </div>
        </div>
    <% }); %>
</div>

<script>
    // Данные для диаграмм
    const professionData = {
        <% professions.forEach(function(profession) { %>
        '<%= profession.id %>': {
            name: '<%= profession.name %>',
            pvks: {
                <% Object.entries(grades[profession.name] || {}).forEach(([pvkName, mark]) => { %>
                '<%= pvkName %>': "<%= mark %>",
                <% }); %>
            }
        },
        <% }); %>
    };

    // Создание диаграмм
    <% professions.forEach(function(profession) { %>
    (function() {
        const ctx = document.getElementById('professionChart<%= profession.id %>').getContext('2d');
        const data = professionData['<%= profession.id %>'];
        const labels = Object.keys(data.pvks);
        const values = Object.values(data.pvks);

        // Генерация цветов
        const backgroundColors = labels.map((_, i) => {
            const hue = 160 + (i * 30) % 360;
            return `hsl(${hue}, 60%, 60%)`;
        });

        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Оценки ПВК',
                    data: values,
                    backgroundColor: backgroundColors,
                    borderColor: '#ffffff',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            color: '#479C92',
                            font: {
                                size: 14,
                                family: 'Arial, sans-serif'
                            },
                            padding: 10,
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    },
                    title: {
                        display: true,
                        text: 'Оценки для ' + data.name,
                        font: {
                            size: 16
                        },
                        color:'#479C92'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return `Оценка экспертов: ${context.raw}`; // Or pvk name `${context.label}: ${context.raw}`
                            }
                        },
                        bodyFont: {
                            size: 14
                        }
                    }
                }
            }
        });
    })();
    <% }); %>
</script>
</body>
</html>