<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Список профессионально-важных качеств</title>
    <link rel="stylesheet" href="../../Styles/piqStyles.css" />
</head>
<body>
<div class="button-container">
    <div class="left-button">
        <button onclick="window.location.href='/main'">Главная страница</button>
    </div>
</div>

<div class="content">
    <h1>Список профессионально-важных качеств</h1>
    <div class="content">
        <ul class="simple-list">
            <% pvks.forEach(function(pvk) { %>
                <li>
                    <strong>Тип:</strong> <%= pvk.type %><br>
                    <strong>ПВК:</strong> <%= pvk.pvk %><br>
                </li>
            <% }); %>
        </ul>
    </div>
</div>
</body>
</html>