<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Список экспертов</title>
    <link rel="stylesheet" href="../../Styles/piqStyles.css" />
</head>
<body>
<div class="button-container">
    <div class="left-button">
        <button onclick="window.location.href='/main'">Главная страница</button>
    </div>
    <div class="right-buttons">
        <button id='profileButton' onclick="window.location.href='/profile'" style="display: none">Профиль</button>
        <button id='loginButton' onclick="window.location.href='/login'">Войти</button>
    </div>
</div>

<div class="content">
    <h1>Список ПВК</h1>
    <div class="content">
        <ul class="simple-list">
            <% pvks.forEach(function(pvk) { %>
                <li>
                    <strong>Тип:</strong> <%= pvk.type %><br>
                    <strong>ПВК:</strong> <%= pvk.pvk %><br>
                </li>
            <% }); %>
        </ul>
    </div>
</div>
<script>
    const profileButton = document.getElementById("profileButton");
    const isLoggedIn = sessionStorage.getItem("isLoggedIn");
    const loginButton = document.getElementById("loginButton");
    if (isLoggedIn === 'true') {
        profileButton.style.display = 'inline-block';
        loginButton.style.display = 'none';
    }
</script>
</body>
</html>