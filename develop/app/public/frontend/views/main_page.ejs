<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Main page</title>
    <link rel="stylesheet" href="../Styles/stylesMain.css">
</head>
<body>

<div class="button-container">
    <div class="dropdown">
        <button class="dropbtn" onclick="toggleDropdown()">Меню</button>
        <div class="dropdown-content" id="dropdownContent">
            <button onclick="window.location.href='/goals'">Цели и задачи</button>
            <button onclick="window.location.href='/developers'">Разработчики</button>
            <button onclick="window.location.href='/aboutProject'">О проекте</button>
            <button id='expertButton' onclick="window.location.href='/experts'" style="display: none">Эксперты</button>
            <button onclick="window.location.href='/pvk'">Список ПВК</button>
            <button id='ratingButton' onclick="window.location.href='/professions_rating'" style="display: none">Оценка</button>
            <button onclick="window.location.href='/results'">Результаты</button>
        </div>
    </div>
    <div class="right-buttons">
        <a href="/login">
            <button id="login-button">Войти</button>
        </a>
        <button id='profileButton' onclick="window.location.href='/profile/<%= login %>'" style="display: none">Профиль</button>
        <a href="/main">
            <button id="logout-button" style="display: none;">Выход</button>
        </a>
    </div>
</div>

<div class="content">
    <h1>IT-профессии</h1>
</div>

<div class="grid">
    <a href="/programmer" class="object">Программист
        <img src="..\Icons\coding_2828881.png" alt="Программист">

    </a>
    <a href="/itSpecialist" class="object">IT-специалист
        <img src="..\Icons\worldwide_2593461.png" alt="IT-специалист">
    </a>
    <a href="/computerScientist" class="object">Информатик
        <img src="..\Icons\data-loss_6743132.png" alt="Информатик">
    </a>
    <a href="/developer" class="object">Разработчик
        <img src="..\Icons\cpu_707475.png" alt="Разработчик">
    </a>
    <a href="/tester" class="object">Тестировщик
        <img src="..\Icons\virus_1320571.png" alt="Тестировщик">
    </a>
    <a href="/businessCompScientist" class="object">Бизнес-информатик
        <img src="..\Icons\fund_2177058 (1).png" alt="Бизнес-информатик">
    </a>
    <a href="/operator" class="object">Оператор ЭВМ
        <img src="..\Icons\sharing_3962127.png" alt="Оператор ЭВМ">
    </a>
    <a href="/sysAdmin" class="object">Системный администратор
        <img src="..\Icons\lock_4693311.png" alt="Системный администратор">
    </a>
    <a href="/gameDeveloper" class="object">Разработчик игр
        <img src="..\Icons\joystick_1588363.png" alt="Разработчик игр">
    </a>
</div>

<script>
    //МЕНЮ
    // Функция для показа/скрытия выпадающего меню
    function toggleDropdown() {
        const dropdownContent = document.getElementById("dropdownContent");
        dropdownContent.classList.toggle("show");
    }

    // Закрытие выпадающего меню при клике вне его области
    window.onclick = function (event) {
        if (!event.target.matches('.dropbtn')) {
            const dropdowns = document.getElementsByClassName("dropdown-content");
            for (let i = 0; i < dropdowns.length; i++) {
                const openDropdown = dropdowns[i];
                if (openDropdown.classList.contains('show')) {
                    openDropdown.classList.remove('show');
                }
            }
        }
    }
    document.addEventListener('DOMContentLoaded', function () {
        const loginButton = document.getElementById('login-button');
        const logoutButton = document.getElementById('logout-button');
        const expertButton = document.getElementById('expertButton');
        const ratingButton = document.getElementById('ratingButton');
        const profileButton = document.getElementById('profileButton');

        function updateAuthButtons() {
            const isLoggedIn = sessionStorage.getItem('isLoggedIn');
            const isAdmin = sessionStorage.getItem('isAdmin');

            if (isLoggedIn === 'true') {
                profileButton.style.display = 'inline-block';
                loginButton.style.display = 'none';
                logoutButton.style.display = 'inline-block'; // Или 'block'
                console.log(sessionStorage.getItem('isAdmin'))
                if (isAdmin === 'true') {
                    expertButton.style.display = 'inline-block';
                    ratingButton.style.display = 'inline-block';
                }
            } else {
                loginButton.style.display = 'inline-block'; // Или 'block'
                logoutButton.style.display = 'none';
            }
        }

        // Изначальная проверка при загрузке страницы
        updateAuthButtons();

        // Обработка выхода:
        logoutButton.addEventListener('click', function () {
            sessionStorage.removeItem('isLoggedIn'); // Удаляем информацию об аутентификации
            updateAuthButtons(); // Обновляем отображение кнопок
        });
    });
</script>
</body>
</html>